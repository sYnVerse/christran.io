# Blog Post Generation Tool - Environment Configuration

# Express Dashboard Server Port (default 5000)
PORT=5000

# Express Dashboard Public URL
# Default is http://localhost:5000. Change this if you have a public domain mapping.
DASHBOARD_URL=http://localhost:5000

# Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Resend API Key (from Resend Dashboard: https://resend.com/)
RESEND_API_KEY=your_resend_api_key_here

# Email Configuration
# The email address where you want to receive daily ideas and drafts.
USER_EMAIL=chris@example.com

# The email address from which notifications are sent.
# If using the Resend free tier, this MUST be onboarding@resend.dev.
# Once you verify a custom domain, you can use something like blog@yourdomain.com.
SENDER_EMAIL=onboarding@resend.dev

# Path to the blog content collection in the Astro project
BLOG_CONTENT_PATH=../../src/content/blog

# Optional: Stock Photo API Keys for Hero Image Manager
# Pexels API Key (Get a free key at: https://www.pexels.com/api/)
PEXELS_API_KEY=
# Unsplash Access Key (Get a free key at: https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=

