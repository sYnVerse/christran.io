---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getFeaturedProjects } from '../data/projects';

const featured = getFeaturedProjects();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" is:inline>
		{
		  "@context": "https://schema.org",
		  "@type": "Person",
		  "name": "Chris Tran",
		  "jobTitle": "Network Engineer",
		  "worksFor": {
		    "@type": "Organization",
		    "name": "Auto-Chlor System"
		  },
		  "url": "https://christran.io",
		  "sameAs": [
		    "https://linkedin.com/in/synchris",
		    "https://github.com/sYnVerse"
		  ],
		  "alumniOf": [
		    {
		      "@type": "EducationalOrganization",
		      "name": "University of California, San Diego"
		    },
		    {
		      "@type": "EducationalOrganization",
		      "name": "Western Governors University"
		    }
		  ],
		  "address": {
		    "@type": "PostalAddress",
		    "addressLocality": "San Francisco Bay Area",
		    "addressRegion": "CA",
		    "addressCountry": "US"
		  }
		}
		</script>
		<style>
			.home-page {
				min-height: 100vh;
				position: relative;
			}
			.home-page::before {
				content: '';
				position: fixed;
				inset: 0;
				background-image: url('/img/network-bg.webp');
				background-size: cover;
				background-position: center;
				image-rendering: -webkit-optimize-contrast;
				image-rendering: crisp-edges;
				z-index: -1;
			}
			.home-page main {
				position: relative;
				background: rgba(11, 16, 33, 0.88);
				padding: 2rem;
				border-radius: 12px;
				margin: 2rem auto;
				width: calc(100% - 2rem);
				max-width: 720px;
				box-sizing: border-box;
			}
			/* Featured section */
			.featured-section {
				margin: 2.5rem 0;
			}
			.featured-heading {
				font-size: 1.4rem;
				margin-bottom: 1.25rem;
				color: rgb(var(--black));
				position: relative;
				padding-bottom: 0.5rem;
			}
			.featured-heading::after {
				content: '';
				position: absolute;
				bottom: 0;
				left: 0;
				width: 3rem;
				height: 2px;
				background: var(--accent);
				border-radius: 1px;
			}
			.featured-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1rem;
				margin-bottom: 1rem;
			}
			.view-all-link {
				display: inline-block;
				color: var(--accent);
				text-decoration: none;
				font-size: 0.9rem;
				font-weight: 500;
				transition: opacity 0.2s ease;
			}
			.view-all-link:hover {
				opacity: 0.8;
			}
			@media (max-width: 640px) {
				.home-page main {
					padding: 1.25rem;
					margin: 1rem auto;
				}
				.featured-grid {
					grid-template-columns: 1fr;
					gap: 1rem;
				}
				.featured-section {
					margin: 1.5rem 0;
				}
			}
		</style>
	</head>
	<body class="home-page">
		<Header />
		<main>
			<h1>Network Engineering.<br />Security.<br />Automation.</h1>
			<p>
				I’m <strong>Chris Tran</strong>, a <strong>San Francisco Bay Area Network Engineer</strong> specializing in IT infrastructure, network security, virtualization, and automation. Currently working at <strong>Auto-Chlor System</strong> and pursuing my M.S. in IT Management at <strong>WGU</strong>, I hold a B.S. in Mathematics-Computer Science from the <strong>University of California, San Diego</strong> (<strong>UCSD</strong>). I am passionate about building reliable infrastructure that just works. Explore my latest projects, read my technical deep-dives, or click the terminal icon in the bottom right to query my skills directly.
			</p>

			<section class="featured-section" aria-label="Featured work">
				<h2 class="featured-heading">Featured Work</h2>
				<div class="featured-grid">
					{featured.map((project) => (
						<ProjectCard project={project} compact />
					))}
				</div>
				<a href="/portfolio" class="view-all-link">View all projects →</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
