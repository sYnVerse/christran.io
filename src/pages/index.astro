---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="home-page">
		<Header />
		<main>
			<h1>Welcome! 👋</h1>
			<p>
				Hi, I'm Chris Tran, a Network Engineer based in the San Francisco Bay Area. I'm passionate about 
				IT infrastructure, network security, and creating efficient technical solutions.
			</p>
			<p>
				This is my digital space where I share my professional journey, technical insights, and occasional 
				thoughts about technology and networking. Feel free to explore my blog posts or learn more about 
				my background and experience.
			</p>
			<div class="cta-links">
				<div class="cta-grid">
					<a href="/about" class="cta-item">
						<h3>About Me →</h3>
						<p>Learn more about my professional background and expertise</p>
					</a>
					<a href="/blog" class="cta-item">
						<h3>Blog →</h3>
						<p>Read my latest thoughts and technical articles</p>
					</a>
				</div>
			</div>
		</main>
		<Footer />
		<style>
			.home-page {
				background-image: url('https://lh3.googleusercontent.com/rd-gg-dl/AOI_d_9Ovko9lE6BoKZAtjI7GKDk8DM1RysWugx5Ic5fda5XnQFpDe1q3qFz3FwBtSgyKZicxGIyFoVTD7idchu7DsC27SzI1AxzTkrRktAlpVjCFEvKLJWl5KZue-u0Hg_rsMWoOQaVc7x1moKtlsWd3-fDkk2avHid1Hiu4jZL5A53Ip3gmC4xPxxYtMam3ouFKsXCmCZX9hZEsYrctv2JSrhW_xhGb-M-PFLhnR1WZH8PIrqugsot02JM-l5ykBUVw3QBYDd_sS4YPyho3HZiZAR4S2Lu8OXmmAgasqIWM0cHRZ52i8BvuAmLzCZGF2fADkzS-s01tHzQDFY3ScA074MdIM88rH8QSx8nvktNg4mfv7I2dTOjg39nubmtnbyEP0LJzU96ae03Ju_iRvmanEBt58_r_i_OdwukBsAGKFP26XoBWEgI7O0nNrbos5ezkqW_fSLq8a6Su2MC-5mw1FCyeT9QU_ci8S1l3ScodKrPMd4gkyKKbuuzlaOY5v9dEbIoHI_VmN_OwFJ_sBeKyUq8eeqa4dxzZ75Bz4_a-M5AyXZbNrzBtb8PTnMmkm-uA94iOCJF697ynJ_JXBOjknSVLWVV-cPvq3qtv3blvC76xH3HaXov_G15Pa2yG8tQE9sEBSeKerr0dTRsHix8rbHxB9PcLeevwm64gUgRdUdiJdiSCucHfwl3JMjW1aE0CeeGT_kLwcTDAcL8vgU5AZA2xcCDIYHtYE8G1pVmrP061caWOvU1iqZgLX8fG4fGl1T1J0zcq6jcw-24LbKGpQoaRVxoji_BRHOjBHTdtbErNseGpW9u_aanA0gkZRl3bWBKKEf_gZXDCbcrmdHJfNMakoM-VbGhUuQAk83bhWKSzDLBRMZlwGZ3cImj2lEBKMHHVbxyGbbTMoRoBbuv44jgVpfINaqhZrF3vlejp59zLLg4eGeYZstctV5F3832COzcLOzypz_fj7rxxsF92AqZ0CJGLkKRZAT4gAUUtsOeM1cHgtyRoIVaxgi-YA7w87drfCW9fC_LrcPAirTVDtID4yWHdZHzmp9WhRZ1O5hLHV0BiwAl0MIIhBYse8lOxVHCDIJEXuw6sI5H5Q3rhzJ2xxb342FRRc3xRt8rdfviTEARl-5zh4muAqoRjSTvHcGFyIKOCgsWc1U6aO9NU5VeTSHIFrfIqswV-q3fwdZqK2v8AahmR9Y=s1024-rj');
