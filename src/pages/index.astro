---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getFeaturedProjects } from '../data/projects';

const featured = getFeaturedProjects();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" is:inline>
		{
		  "@context": "https://schema.org",
		  "@type": "Person",
		  "name": "Chris Tran",
		  "jobTitle": "Network Engineer",
		  "worksFor": {
		    "@type": "Organization",
		    "name": "Auto-Chlor System"
		  },
		  "url": "https://christran.io",
		  "sameAs": [
		    "https://linkedin.com/in/synchris",
		    "https://github.com/sYnVerse"
		  ],
		  "alumniOf": [
		    {
		      "@type": "EducationalOrganization",
		      "name": "University of California, San Diego"
		    },
		    {
		      "@type": "EducationalOrganization",
		      "name": "Western Governors University"
		    }
		  ],
		  "address": {
		    "@type": "PostalAddress",
		    "addressLocality": "San Francisco Bay Area",
		    "addressRegion": "CA",
		    "addressCountry": "US"
		  }
		}
		</script>
	</head>
	<body class="home-page">
		<div class="loader-overlay" id="loader-overlay" role="status" aria-live="polite" aria-label="Loading">
			<div class="loader-content">
				<svg class="loader-network" viewBox="0 0 120 120" aria-hidden="true">
					<defs>
						<linearGradient id="loader-grad" x1="0%" y1="0%" x2="100%" y2="100%">
							<stop offset="0%" stop-color="var(--accent)" />
							<stop offset="100%" stop-color="var(--accent-dark)" />
						</linearGradient>
					</defs>
					<!-- network nodes -->
					<circle class="loader-node" cx="60" cy="60" r="6" fill="url(#loader-grad)" />
					<circle class="loader-node" cx="60" cy="20" r="5" fill="url(#loader-grad)" />
					<circle class="loader-node" cx="95" cy="45" r="5" fill="url(#loader-grad)" />
					<circle class="loader-node" cx="95" cy="95" r="5" fill="url(#loader-grad)" />
					<circle class="loader-node" cx="25" cy="95" r="5" fill="url(#loader-grad)" />
					<circle class="loader-node" cx="25" cy="45" r="5" fill="url(#loader-grad)" />
					<!-- links (draw in sequence) -->
					<line class="loader-link" x1="60" y1="60" x2="60" y2="20" />
					<line class="loader-link" x1="60" y1="60" x2="95" y2="45" />
					<line class="loader-link" x1="60" y1="60" x2="95" y2="95" />
					<line class="loader-link" x1="60" y1="60" x2="25" y2="95" />
					<line class="loader-link" x1="60" y1="60" x2="25" y2="45" />
					<!-- packet traveling the path -->
					<circle class="loader-packet" r="4" fill="#7B9EFF">
						<animateMotion dur="0.5s" repeatCount="1" fill="freeze" path="M60 60 L60 20 L95 45 L60 60 L95 95 L60 60 L25 95 L60 60 L25 45 Z" />
					</circle>
				</svg>
				<p class="loader-text">Establishing connection...</p>
			</div>
		</div>
		<Header />
		<main>
			<h1>Network Engineering. Security. Automation.</h1>
			<p>
				I’m <strong>Chris Tran</strong>, a <strong>San Francisco Bay Area Network Engineer</strong> specializing in IT infrastructure, network security, virtualization, and automation. Currently working at <strong>Auto-Chlor System</strong> and pursuing my M.S. in IT Management at <strong>WGU</strong>, I hold a B.S. in Mathematics-Computer Science from the <strong>University of California, San Diego</strong> (<strong>UCSD</strong>). I am passionate about building reliable infrastructure that just works. Explore my latest projects, read my technical deep-dives, or click the terminal icon in the bottom right to query my skills directly.
			</p>

			<section class="featured-section" aria-label="Featured work">
				<h2 class="featured-heading">Featured Work</h2>
				<div class="featured-grid">
					{featured.map((project) => (
						<ProjectCard project={project} compact />
					))}
				</div>
				<a href="/portfolio" class="view-all-link">View all projects →</a>
			</section>
		</main>

		<button id="terminal-trigger" class="terminal-trigger-btn" aria-label="Open interactive terminal" aria-expanded="false" aria-controls="terminal-widget">
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="trigger-icon-svg"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="close-icon-svg" style="display: none;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
		</button>

		<section class="terminal-widget" id="terminal-widget" aria-label="Interactive terminal widget">
			<div class="terminal-window" id="terminal-window">
				<div class="terminal-titlebar">
					<div class="terminal-dots">
						<span class="dot red" id="terminal-dot-close" title="Close" role="button" aria-label="Close terminal"></span>
						<span class="dot yellow"></span>
						<span class="dot green"></span>
					</div>
					<span class="terminal-title">visitor@christran.io — bash</span>
				</div>
				<div class="terminal-body">
					<div class="terminal-output" id="term-output" role="log">
						<div class="term-line">
							<span class="term-prompt">visitor@christran.io:~$</span>type a command and press Enter. try <code>help</code> or <code>ls</code>
						</div>
					</div>
					<div class="terminal-input-line">
						<span class="term-prompt term-prompt-full">visitor@christran.io:~$</span>
						<span class="term-prompt term-prompt-short" aria-hidden="true">$ </span>
						<span class="terminal-input-wrap">
							<span class="terminal-input-val" id="term-input-val" aria-hidden="true"></span>
							<span class="term-cursor" aria-hidden="true"></span>
							<input
								type="text"
								class="terminal-input"
								id="term-input"
								autocomplete="off"
								autocapitalize="off"
								spellcheck="false"
								aria-label="Terminal command input"
							/>
						</span>
					</div>
				</div>
			</div>
		</section>

		<Footer />
		<style>
			.loader-overlay {
				position: fixed;
				inset: 0;
				z-index: 9999;
				background: rgba(11, 16, 33, 0.96);
				display: flex;
				align-items: center;
				justify-content: center;
				transition: opacity 0.175s ease-out, visibility 0.175s ease-out;
			}
			.loader-overlay.hide {
				opacity: 0;
				visibility: hidden;
				pointer-events: none;
			}
			.loader-content {
				text-align: center;
			}
			.loader-network {
				width: 140px;
				height: 140px;
				display: block;
				margin: 0 auto 1rem;
			}
			.loader-node {
				opacity: 0;
				animation: loader-node-in 0.075s ease-out forwards;
			}
			.loader-node:nth-child(1) { animation-delay: 0s; }
			.loader-node:nth-child(2) { animation-delay: 0.04s; }
			.loader-node:nth-child(3) { animation-delay: 0.08s; }
			.loader-node:nth-child(4) { animation-delay: 0.12s; }
			.loader-node:nth-child(5) { animation-delay: 0.16s; }
			.loader-node:nth-child(6) { animation-delay: 0.2s; }
			@keyframes loader-node-in {
				to { opacity: 1; }
			}
			.loader-link {
				stroke: rgba(123, 158, 255, 0.4);
				stroke-width: 2;
				stroke-dasharray: 120;
				stroke-dashoffset: 120;
				animation: loader-link-draw 0.1s ease-out forwards;
			}
			.loader-link:nth-of-type(1) { animation-delay: 0.025s; }
			.loader-link:nth-of-type(2) { animation-delay: 0.1s; }
			.loader-link:nth-of-type(3) { animation-delay: 0.175s; }
			.loader-link:nth-of-type(4) { animation-delay: 0.25s; }
			.loader-link:nth-of-type(5) { animation-delay: 0.325s; }
			.loader-link:nth-of-type(6) { animation-delay: 0.4s; }
			@keyframes loader-link-draw {
				to { stroke-dashoffset: 0; }
			}
			.loader-packet {
				filter: drop-shadow(0 0 4px var(--accent));
			}
			.loader-text {
				margin: 0;
				font-size: 0.9rem;
				color: rgba(210, 215, 235, 0.8);
				letter-spacing: 0.05em;
			}
			.home-page {
				min-height: 100vh;
				position: relative;
			}
			.home-page::before {
				content: '';
				position: fixed;
				inset: 0;
				background-image: url('/img/network-bg.webp');
				background-size: cover;
				background-position: center;
				image-rendering: -webkit-optimize-contrast;
				image-rendering: crisp-edges;
				z-index: -1;
			}
			.home-page main {
				position: relative;
				background: rgba(11, 16, 33, 0.88);
				padding: 2rem;
				border-radius: 12px;
				margin: 2rem auto;
				max-width: 720px;
				box-sizing: border-box;
			}
			/* Floating Terminal Widget */
			.terminal-trigger-btn {
				position: fixed;
				bottom: 2rem;
				right: 2rem;
				width: 56px;
				height: 56px;
				border-radius: 50%;
				background: linear-gradient(135deg, rgba(30, 35, 50, 0.95) 0%, rgba(15, 20, 35, 0.98) 100%);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				border: 1px solid rgba(123, 158, 255, 0.3);
				color: var(--accent);
				display: flex;
				align-items: center;
				justify-content: center;
				cursor: pointer;
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1);
				z-index: 1001;
				transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
			}
			.terminal-trigger-btn:hover {
				transform: translateY(-4px) scale(1.05);
				border-color: var(--accent);
				box-shadow: 0 12px 40px rgba(123, 158, 255, 0.25);
			}
			.terminal-trigger-btn:active {
				transform: translateY(-1px) scale(0.98);
			}
			.terminal-widget {
				position: fixed;
				bottom: 6rem;
				right: 2rem;
				width: 760px;
				height: 480px;
				max-width: calc(100vw - 4rem);
				max-height: calc(100vh - 9rem);
				z-index: 1000;
				display: flex;
				flex-direction: column;
				opacity: 0;
				transform: translateY(20px) scale(0.95);
				pointer-events: none;
				transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
			}
			.terminal-widget.open {
				opacity: 1;
				transform: translateY(0) scale(1);
				pointer-events: auto;
			}
			.terminal-widget .terminal-window {
				height: 100%;
				display: flex;
				flex-direction: column;
				box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
			}
			.terminal-widget .terminal-body {
				flex: 1;
				display: block !important;
				overflow-y: auto;
				min-height: 0;
				padding: 0.75rem 1rem;
			}
			.terminal-widget .terminal-output {
				max-height: none;
				overflow-y: visible;
				margin-bottom: 0.5rem;
			}
			.terminal-widget .dot.red {
				cursor: pointer;
				position: relative;
			}
			.terminal-widget .dot.red:hover::after {
				content: '×';
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -52%);
				font-size: 8px;
				color: rgba(0, 0, 0, 0.6);
				font-weight: bold;
			}
			@media (max-width: 640px) {
				.terminal-widget {
					top: calc(1rem + env(safe-area-inset-top));
					bottom: 5.5rem;
					right: 1rem;
					width: calc(100vw - 2rem);
					height: auto;
					max-width: none;
					max-height: none;
				}
				.terminal-trigger-btn {
					bottom: 1.5rem;
					right: 1rem;
				}
				.home-page main {
					padding: 1.25rem;
				}
			}
			.terminal-window {
				font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, monospace;
				font-size: 0.85rem;
				line-height: 1.5;
				background: #1a1d29;
				border-radius: 10px;
				overflow-x: auto;
				overflow-y: hidden;
				box-shadow: var(--box-shadow), 0 0 0 1px rgba(123, 158, 255, 0.15);
				max-width: 100%;
				min-width: 0;
			}
			.terminal-titlebar {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				padding: 0.5rem 0.75rem;
				background: #252836;
				border-bottom: 1px solid rgba(0, 0, 0, 0.3);
				cursor: text;
			}
			.terminal-dots {
				display: flex;
				gap: 6px;
			}
			.terminal-dots .dot {
				width: 10px;
				height: 10px;
				border-radius: 50%;
			}
			.terminal-dots .dot.red { background: #ff5f56; }
			.terminal-dots .dot.yellow { background: #ffbd2e; }
			.terminal-dots .dot.green { background: #27c93f; }
			.terminal-title {
				color: rgba(210, 215, 235, 0.7);
				font-size: 0.75rem;
			}
			.terminal-body {
				display: block !important;
				padding: 0.75rem 1rem;
				min-height: 210px;
				overflow-y: auto;
				cursor: text;
			}
			.terminal-output {
				margin-bottom: 0.5rem;
			}
			.terminal-output .term-line {
				margin-bottom: 0.25rem;
				word-break: break-word;
			}
			.terminal-output .term-line code {
				background: rgba(123, 158, 255, 0.2);
				padding: 1px 4px;
				border-radius: 3px;
			}
			.term-prompt {
				color: var(--accent);
				margin-right: 0.5rem;
			}
			/* Apply prompt color to dynamically appended lines (Astro scoping doesn't apply to innerHTML) */
			.terminal-output :global(.term-prompt) {
				color: var(--accent);
				margin-right: 0.5rem;
			}
			.term-prompt-short {
				display: none;
			}
			.terminal-input-line {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0;
			}
			.terminal-input-wrap {
				display: inline-flex;
				align-items: center;
				flex: 1;
				min-width: 0;
				position: relative;
			}
			.terminal-input-val {
				white-space: pre-wrap;
				word-break: break-all;
				font: inherit;
				color: rgb(var(--gray-dark));
			}
			.terminal-input {
				position: absolute;
				left: 0;
				top: 0;
				width: 100%;
				height: 100%;
				color: transparent;
				background: transparent;
				caret-color: transparent;
				border: none;
				outline: none;
				font: inherit;
				padding: 0;
				margin: 0;
				z-index: 2;
			}
			.terminal-input::placeholder {
				color: rgba(210, 215, 235, 0.4);
			}
			.term-cursor {
				display: inline-block;
				width: 8px;
				height: 1.1em;
				background: var(--accent);
				animation: blink 1s step-end infinite;
				vertical-align: text-bottom;
			}
			@keyframes blink {
				50% { opacity: 0; }
			}
			.terminal-output .term-response {
				color: rgb(var(--gray));
				white-space: pre-wrap;
			}
			.terminal-output .term-response a {
				color: inherit;
				text-decoration: underline;
			}
			.terminal-output .term-response a:hover {
				color: var(--accent);
			}

			@media (max-width: 640px) {
				.home-page {
					overflow-x: hidden;
				}
				.home-page main {
					width: 100%;
					max-width: 100%;
					padding: 1rem;
					margin: 0.5rem 0;
					overflow-x: hidden;
				}
				.terminal-section {
					margin-top: 1.5rem;
				}
				.terminal-window {
					font-size: 0.75rem;
					border-radius: 8px;
					max-width: 100%;
				}
				.terminal-titlebar {
					padding: 0.4rem 0.6rem;
				}
				.terminal-title {
					max-width: 60%;
					overflow: hidden;
					text-overflow: ellipsis;
					white-space: nowrap;
				}
				.terminal-body {
					padding: 0.5rem 0.75rem;
					min-height: 180px;
					max-width: 100%;
					overflow-x: auto;
				}
				.terminal-output {
					max-height: 240px;
					margin-bottom: 0.4rem;
				}
				.terminal-input-line {
					min-width: 0;
				}
			}

			/* Featured section */
			.featured-section {
				margin: 2.5rem 0;
			}
			.featured-heading {
				font-size: 1.4rem;
				margin-bottom: 1.25rem;
				color: rgb(var(--black));
				position: relative;
				padding-bottom: 0.5rem;
			}
			.featured-heading::after {
				content: '';
				position: absolute;
				bottom: 0;
				left: 0;
				width: 3rem;
				height: 2px;
				background: var(--accent);
				border-radius: 1px;
			}
			.featured-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1rem;
				margin-bottom: 1rem;
			}
			.view-all-link {
				display: inline-block;
				color: var(--accent);
				text-decoration: none;
				font-size: 0.9rem;
				font-weight: 500;
				transition: opacity 0.2s ease;
			}
			.view-all-link:hover {
				opacity: 0.8;
			}
			@media (max-width: 640px) {
				.featured-grid {
					grid-template-columns: 1fr;
					gap: 1rem;
				}
				.featured-section {
					margin: 1.5rem 0;
				}
			}
		</style>
		<script is:inline>
			document.addEventListener('DOMContentLoaded', function () {
				var loader = document.getElementById('loader-overlay');
				if (loader) {
					setTimeout(function () {
						loader.classList.add('hide');
					}, 500);
				}

				const output = document.getElementById('term-output');
				const input = document.getElementById('term-input');
				const terminalWindow = document.getElementById('terminal-window');
				if (!output || !input) return;

				if (terminalWindow) {
					terminalWindow.addEventListener('click', function () {
						input.focus();
					});
				}

				const inputVal = document.getElementById('term-input-val');
				function updateInputText() {
					if (inputVal) {
						inputVal.textContent = input.value;
					}
				}
				updateInputText();
				input.addEventListener('input', updateInputText);

				const promptText = 'visitor@christran.io:~$';

				const commands = {
					whoami: function () {
						return 'chris\n\nNetwork Engineer in the SF Bay Area. IT infrastructure, security, and turning caffeine into configs.';
					},
					'ping skills': function () {
						return 'PING skills.chris.local (10.0.0.42) 56(84) bytes of data.\n64 bytes from skills: icmp_seq=1 ttl=64 time=0.042 ms\n--- skills.chris.local ping statistics ---\n1 packets transmitted, 1 received, 0% packet loss\n\nKey skills: networking, security, automation, and way too many tabs of documentation.';
					},
					'traceroute career': function () {
						return 'traceroute to career (192.168.1.1), 30 hops max\n 1  foothill.edu (1.2 ms)\n 2  ucsd.edu (4.8 ms)\n 3  amazon.com (8.4 ms)\n 4  santaclaracounty.gov (12.1 ms)\n 5  microsoft.com (18.7 ms)\n 6  autochlor.com (22.3 ms)\n 7  wgu.edu (28.9 ms)\n\nDestination reached. Next hop: whatever I\'m building next!';
					},
					ls: function () {
						return '__HTML__' + 'skills  certs  contact  portfolio  resume  about<br><br>Tip: try <code>cat resume</code>, <code>certs</code>, or <code>contact</code>.';
					},
					certs: function () {
						return 'Certificate inventory (chris.local):\n\n  ITILv4 Foundations\n  CompTIA A+\n  CompTIA Network+ (in progress)\n  CompTIA Security+ (planned)\n  (and counting — always learning)';
					},
					skills: function () {
						return 'Technical skills:\n\n  Networking: routing, switching, firewall, VPN, DNS, DHCP\n  Security: hardening, monitoring, incident response\n  Automation: Python, Ansible, Bash, APIs\n  Cloud/Infra: AWS, Cloudflare Workers, GitHub CI/CD';
					},
					contact: function () {
						return '__HTML__' + 'Reach out:<br><br>  <a href="https://linkedin.com/in/synchris" target="_blank" rel="noopener noreferrer">LinkedIn</a> — connect professionally<br>  <a href="https://github.com/sYnVerse" target="_blank" rel="noopener noreferrer">GitHub</a> — code & projects<br>  <a href="/resume" target="_blank" rel="noopener noreferrer">Resume</a> — full background';
					},
					projects: function () {
						return '__HTML__' + 'Selected projects and apps. Browse all: <a href="/portfolio" target="_blank" rel="noopener noreferrer">/portfolio</a>';
					},
					portfolio: function () {
						return '__HTML__' + 'Selected projects and apps. Browse all: <a href="/portfolio" target="_blank" rel="noopener noreferrer">/portfolio</a>';
					},
					resume: function () {
						return '__HTML__' + 'Network Engineer · Security · Automation. Full resume: <a href="/resume" target="_blank" rel="noopener noreferrer">/resume</a>';
					},
					'cat resume': function () {
						return '__HTML__' + 'Network Engineer · Security · Automation. Full resume: <a href="/resume" target="_blank" rel="noopener noreferrer">/resume</a>';
					},
					about: function () {
						return '__HTML__' + 'More about me: <a href="/about" target="_blank" rel="noopener noreferrer">/about</a>';
					},
					help: function () {
						return 'Available commands:\n  \u2002whoami              — who is Chris?\n  \u2002ping skills        — probe my skills\n  \u2002traceroute career  — path of my career\n  \u2002ls                  — list areas to explore\n  \u2002certs               — certifications\n  \u2002skills              — technical skills\n  \u2002contact             — LinkedIn, GitHub, resume\n  \u2002portfolio           — projects & apps\n  \u2002resume / cat resume — resume summary\n  \u2002about               — about page\n  \u2002clear               — clear the screen';
					},
					clear: function () { return '__CLEAR__'; }
				};

				function appendLine(html) {
					const line = document.createElement('div');
					line.className = 'term-line';
					line.innerHTML = html;
					output.appendChild(line);
					
					const body = output.parentElement;
					if (body) {
						body.scrollTop = body.scrollHeight;
					}
				}

				function escapeHtml(s) {
					const div = document.createElement('div');
					div.textContent = s;
					return div.innerHTML;
				}

				function escapeHtmlWithBreaks(s) {
					return s.split('\n').map(escapeHtml).join('<br>');
				}

				function runCommand(cmd) {
					const trimmed = cmd.trim().toLowerCase();
					// Aliases: tr, tracert -> traceroute career; ping -> ping skills; certifications -> certs
					var canonical = trimmed;
					if (trimmed === 'tr' || trimmed === 'tracert' || trimmed === 'tracert career') canonical = 'traceroute career';
					else if (trimmed === 'ping') canonical = 'ping skills';
					else if (trimmed === 'certifications') canonical = 'certs';
					const response = commands[canonical];
					if (response === undefined) {
						appendLine('<span class="term-prompt">' + promptText + '</span>' + escapeHtml(cmd));
						appendLine('<span class="term-response">bash: ' + escapeHtml(trimmed) + ': command not found. Try `help`</span>');
						return;
					}
					appendLine('<span class="term-prompt">' + promptText + '</span>' + escapeHtml(cmd));
					const result = typeof response === 'function' ? response() : response;
					if (result === '__CLEAR__') {
						output.innerHTML = '';
						return;
					}
					if (String(result).indexOf('__HTML__') === 0) {
						appendLine('<span class="term-response">' + result.slice(7) + '</span>');
						return;
					}
					if (canonical === 'traceroute career') {
						const tracerouteHtml = 'traceroute to career (192.168.1.1), 30 hops max<br> 1  <a href="https://foothill.edu" target="_blank" rel="noopener noreferrer">foothill.edu</a> (1.2 ms)<br> 2  <a href="https://ucsd.edu" target="_blank" rel="noopener noreferrer">ucsd.edu</a> (4.8 ms)<br> 3  <a href="https://amazon.com" target="_blank" rel="noopener noreferrer">amazon.com</a> (8.4 ms)<br> 4  <a href="https://santaclaracounty.gov" target="_blank" rel="noopener noreferrer">santaclaracounty.gov</a> (12.1 ms)<br> 5  <a href="https://microsoft.com" target="_blank" rel="noopener noreferrer">microsoft.com</a> (18.7 ms)<br> 6  <a href="https://autochlor.com" target="_blank" rel="noopener noreferrer">autochlor.com</a> (22.3 ms)<br> 7  <a href="https://wgu.edu" target="_blank" rel="noopener noreferrer">wgu.edu</a> (28.9 ms)<br><br>Destination reached. Next hop: whatever I\'m building next!';
						appendLine('<span class="term-response">' + tracerouteHtml + '</span>');
						return;
					}
					appendLine('<span class="term-response">' + escapeHtmlWithBreaks(result) + '</span>');
				}

				const history = [];
				let historyIndex = -1;

				const autocompleteCandidates = [
					'whoami',
					'ping skills',
					'traceroute career',
					'ls',
					'certs',
					'skills',
					'contact',
					'portfolio',
					'resume',
					'cat resume',
					'about',
					'clear',
					'help'
				];

				function handleTabComplete() {
					const val = input.value;
					const trimmed = val.toLowerCase();
					
					// Filter matching candidates
					const matches = autocompleteCandidates.filter(function (c) {
						return c.indexOf(trimmed) === 0;
					});
					
					if (matches.length === 0) {
						return; // No matches
					}
					
					if (matches.length === 1) {
						input.value = matches[0];
						updateInputText();
					} else {
						// Find longest common prefix
						let longestPrefix = matches[0];
						for (let i = 1; i < matches.length; i++) {
							let j = 0;
							while (j < longestPrefix.length && j < matches[i].length && longestPrefix[j] === matches[i][j]) {
								j++;
							}
							longestPrefix = longestPrefix.slice(0, j);
						}
						
						if (longestPrefix.length > trimmed.length) {
							input.value = longestPrefix;
							updateInputText();
						} else {
							// Print matches
							appendLine('<span class="term-prompt">' + promptText + '</span>' + escapeHtml(val));
							appendLine('<span class="term-response">' + matches.join('    ') + '</span>');
						}
					}
				}

				input.addEventListener('keydown', function (e) {
					if (e.key === 'Tab') {
						e.preventDefault();
						handleTabComplete();
					} else if (e.key === 'ArrowUp') {
						e.preventDefault();
						if (history.length > 0) {
							if (historyIndex === -1) {
								historyIndex = history.length - 1;
							} else if (historyIndex > 0) {
								historyIndex--;
							}
							input.value = history[historyIndex];
							updateInputText();
							setTimeout(function () {
								input.selectionStart = input.selectionEnd = input.value.length;
							}, 0);
						}
					} else if (e.key === 'ArrowDown') {
						e.preventDefault();
						if (history.length > 0 && historyIndex !== -1) {
							if (historyIndex < history.length - 1) {
								historyIndex++;
								input.value = history[historyIndex];
							} else {
								historyIndex = -1;
								input.value = '';
							}
							updateInputText();
							setTimeout(function () {
								input.selectionStart = input.selectionEnd = input.value.length;
							}, 0);
						}
					} else if (e.key === 'Enter') {
						e.preventDefault();
						var cmd = input.value;
						input.value = '';
						updateInputText();
						
						if (cmd.trim() !== '') {
							if (history.length === 0 || history[history.length - 1] !== cmd) {
								history.push(cmd);
							}
							historyIndex = -1;
						}
						
						runCommand(cmd);
					}
				});

				// Terminal widget trigger & close logic
				const trigger = document.getElementById('terminal-trigger');
				const widget = document.getElementById('terminal-widget');
				const dotClose = document.getElementById('terminal-dot-close');
				const triggerIcon = trigger ? trigger.querySelector('.trigger-icon-svg') : null;
				const closeIcon = trigger ? trigger.querySelector('.close-icon-svg') : null;

				function toggleTerminal() {
					if (!widget || !trigger) return;
					const isOpen = widget.classList.toggle('open');
					trigger.setAttribute('aria-expanded', String(isOpen));
					if (isOpen) {
						if (triggerIcon) triggerIcon.style.display = 'none';
						if (closeIcon) closeIcon.style.display = 'block';
						// Focus input immediately on desktop, with a slight delay on mobile
						if (window.innerWidth > 640) {
							input.focus();
						} else {
							setTimeout(function () {
								input.focus();
							}, 150);
						}
					} else {
						if (triggerIcon) triggerIcon.style.display = 'block';
						if (closeIcon) closeIcon.style.display = 'none';
						input.blur();
					}
				}

				if (trigger) {
					trigger.addEventListener('click', toggleTerminal);
				}

				if (dotClose) {
					dotClose.addEventListener('click', function (e) {
						e.stopPropagation();
						toggleTerminal();
					});
				}

				// Click outside to close (desktop only, to avoid issues on mobile tap interactions)
				document.addEventListener('click', function (event) {
					if (!widget || !trigger) return;
					if (widget.classList.contains('open') && 
						!widget.contains(event.target) && 
						!trigger.contains(event.target)) {
						toggleTerminal();
					}
				});
			});
		</script>
	</body>
</html>

