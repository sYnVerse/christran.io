---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getFeaturedProjects } from '../data/projects';

const featured = getFeaturedProjects();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" is:inline>
		{
		  "@context": "https://schema.org",
		  "@type": "Person",
		  "name": "Chris Tran",
		  "jobTitle": "Network Engineer",
		  "worksFor": {
		    "@type": "Organization",
		    "name": "Auto-Chlor System"
		  },
		  "url": "https://christran.io",
		  "sameAs": [
		    "https://linkedin.com/in/synchris",
		    "https://github.com/sYnVerse"
		  ],
		  "alumniOf": [
		    {
		      "@type": "EducationalOrganization",
		      "name": "University of California, San Diego"
		    },
		    {
		      "@type": "EducationalOrganization",
		      "name": "Western Governors University"
		    }
		  ],
		  "address": {
		    "@type": "PostalAddress",
		    "addressLocality": "San Francisco Bay Area",
		    "addressRegion": "CA",
		    "addressCountry": "US"
		  }
		}
		</script>
		<style>
			.home-page {
				min-height: 100vh;
				position: relative;
			}
			/* Custom header styling on homepage for fixed glassmorphic layout */
			.home-page :global(header) {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 10;
				background: rgba(11, 16, 33, 0.4) !important;
				backdrop-filter: blur(16px);
				border-bottom: 1px solid rgba(255, 255, 255, 0.06);
				transition: background-color 0.3s ease, border-color 0.3s ease;
			}
			.home-page::before {
				content: '';
				position: fixed;
				inset: -40px; /* Prevents edge gaps during background translations */
				background-image: url('/img/network-bg.webp');
				background-size: cover;
				background-position: center;
				image-rendering: -webkit-optimize-contrast;
				image-rendering: crisp-edges;
				z-index: -1;
				opacity: var(--bg-opacity, 0.25);
				will-change: transform, opacity;
				transform: translateY(var(--bg-translate, 0px)) scale(var(--bg-scale, 1));
				transition: transform 0.1s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.15s ease-out;
			}
			/* Hero scroll pin wrapper (tracks scroll progress for sequential animation) */
			.hero-wrapper {
				height: 220vh; /* Pinned for 1.2 viewport heights */
				position: relative;
			}
			/* Full Screen Hero Section (Sticky) */
			.hero-section {
				height: 100vh;
				position: sticky;
				top: 0;
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
				overflow: hidden;
				padding: 2rem;
				box-sizing: border-box;
			}
			.hero-content {
				width: 100%;
				max-width: 800px;
				margin: auto 0;
			}
			.tagline-parallax {
				font-size: clamp(2rem, 9vw, 4.6rem);
				line-height: 1.1;
				margin-bottom: 0;
				font-weight: 800;
				letter-spacing: -0.03em;
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
				overflow: visible; /* Avoid clipping text scale and glow */
			}
			.tagline-line {
				display: block;
				will-change: transform, opacity;
				transition: transform 0.12s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.12s cubic-bezier(0.25, 1, 0.5, 1);
				transform: translateX(var(--translate, 0px));
				opacity: var(--opacity, 1); /* Safe fallback for non-JS users */
				cursor: default;
			}
			.line-1 {
				--translate: var(--translate-1, 0px);
				--opacity: var(--opacity-1, 1);
				background: linear-gradient(135deg, #FFFFFF 30%, var(--accent) 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
			}
			.line-2 {
				--translate: var(--translate-2, 0px);
				--opacity: var(--opacity-2, 1);
				color: #FFFFFF;
				text-shadow: 0 0 40px rgba(255, 255, 255, 0.1);
				padding-left: 2rem;
			}
			.line-3 {
				--translate: var(--translate-3, 0px);
				--opacity: var(--opacity-3, 1);
				background: linear-gradient(135deg, var(--accent) 0%, #A5C0FF 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
				padding-left: 4rem;
			}
			.tagline-line:hover {
				filter: drop-shadow(0 0 12px rgba(123, 158, 255, 0.6));
				transform: translateX(var(--translate, 0px)) scale(1.02);
				transition: transform 0.2s cubic-bezier(0.25, 1, 0.5, 1), filter 0.2s ease;
			}
			@media (prefers-reduced-motion: reduce) {
				.tagline-line {
					transform: none !important;
					transition: none !important;
					will-change: auto;
				}
			}
			/* Scroll indicator */
			.scroll-indicator {
				position: absolute;
				bottom: 3.5rem;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.6rem;
				opacity: var(--scroll-indicator-opacity, 1);
				transition: opacity 0.2s ease, transform 0.2s ease;
				transform: translateY(calc((1 - var(--scroll-indicator-opacity, 1)) * 10px));
				pointer-events: none;
			}
			.scroll-text {
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.25em;
				color: var(--accent);
				font-weight: 600;
				opacity: 0.8;
			}
			.mouse-icon {
				width: 22px;
				height: 36px;
				border: 2px solid rgba(176, 186, 209, 0.4);
				border-radius: 11px;
				position: relative;
			}
			.mouse-wheel {
				width: 4px;
				height: 8px;
				background: var(--accent);
				border-radius: 2px;
				position: absolute;
				top: 6px;
				left: 50%;
				transform: translateX(-50%);
				animation: mouse-scroll-anim 1.6s infinite ease-in-out;
			}
			@keyframes mouse-scroll-anim {
				0% {
					top: 6px;
					opacity: 1;
				}
				50% {
					top: 18px;
					opacity: 0;
				}
				100% {
					top: 6px;
					opacity: 1;
				}
			}

			.home-page main {
				position: relative;
				background: rgba(11, 16, 33, 0.88);
				padding: 2.5rem 2rem;
				border-radius: 12px;
				margin: 0 auto 4rem auto;
				width: calc(100% - 2rem);
				max-width: 720px;
				box-sizing: border-box;
				box-shadow: var(--box-shadow);
				border: 1px solid rgba(255, 255, 255, 0.05);
				z-index: 2;
			}
			/* Featured section */
			.featured-section {
				margin: 2.5rem 0;
			}
			.featured-heading {
				font-size: 1.4rem;
				margin-bottom: 1.25rem;
				color: rgb(var(--black));
				position: relative;
				padding-bottom: 0.5rem;
			}
			.featured-heading::after {
				content: '';
				position: absolute;
				bottom: 0;
				left: 0;
				width: 3rem;
				height: 2px;
				background: var(--accent);
				border-radius: 1px;
			}
			.featured-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1rem;
				margin-bottom: 1rem;
			}
			.view-all-link {
				display: inline-block;
				color: var(--accent);
				text-decoration: none;
				font-size: 0.9rem;
				font-weight: 500;
				transition: opacity 0.2s ease;
			}
			.view-all-link:hover {
				opacity: 0.8;
			}
			@media (max-width: 640px) {
				.home-page main {
					padding: 1.25rem;
					margin: 1rem auto 3rem auto;
				}
				.featured-grid {
					grid-template-columns: 1fr;
					gap: 1rem;
				}
				.featured-section {
					margin: 1.5rem 0;
				}
			}
		</style>
	</head>
	<body class="home-page">
		<Header />
		
		<div class="hero-wrapper">
			<div class="hero-section">
				<div class="hero-content">
					<h1 class="tagline-parallax" aria-label="Network Engineering, Security, Automation">
						<span class="tagline-line line-1" aria-hidden="true">Network Engineering.</span>
						<span class="tagline-line line-2" aria-hidden="true">Security.</span>
						<span class="tagline-line line-3" aria-hidden="true">Automation.</span>
					</h1>
				</div>
				
				<div class="scroll-indicator" aria-hidden="true">
					<span class="scroll-text">Scroll to explore</span>
					<div class="mouse-icon">
						<span class="mouse-wheel"></span>
					</div>
				</div>
			</div>
		</div>

		<main>
			<p>
				I’m <strong>Chris Tran</strong>, a <strong>San Francisco Bay Area Network Engineer</strong> specializing in IT infrastructure, network security, virtualization, and automation. Currently working at <strong>Auto-Chlor System</strong> and pursuing my M.S. in IT Management at <strong>WGU</strong>, I hold a B.S. in Mathematics-Computer Science from the <strong>University of California, San Diego</strong> (<strong>UCSD</strong>). I am passionate about building reliable infrastructure that just works. Explore my latest projects, read my technical deep-dives, or click the terminal icon in the bottom right to query my skills directly.
			</p>

			<section class="featured-section" aria-label="Featured work">
				<h2 class="featured-heading">Featured Work</h2>
				<div class="featured-grid">
					{featured.map((project) => (
						<ProjectCard project={project} compact />
					))}
				</div>
				<a href="/portfolio" class="view-all-link">View all projects →</a>
			</section>
		</main>
		<Footer />
		
		<script>
			const initParallax = () => {
				const tagline = document.querySelector('.tagline-parallax');
				const wrapper = document.querySelector('.hero-wrapper');
				const scrollIndicator = document.querySelector('.scroll-indicator');
				const body = document.body;
				if (!tagline || !wrapper) return;

				const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

				// Cache layout values to prevent layout thrashing on scroll
				let viewportHeight = window.innerHeight;
				let wrapperHeight = wrapper.offsetHeight;
				let scrollRange = wrapperHeight - viewportHeight;

				const handleResize = () => {
					viewportHeight = window.innerHeight;
					wrapperHeight = wrapper.offsetHeight;
					scrollRange = wrapperHeight - viewportHeight;
				};

				window.addEventListener('resize', handleResize, { passive: true });

				const handleScroll = () => {
					const scrollY = window.scrollY;

					// Calculate scroll progress (0 to 1) inside the pinned region
					const p = scrollRange > 0 ? Math.min(1, Math.max(0, scrollY / scrollRange)) : 0;

					// 1. Background vertical scroll parallax, scale, and fade-in
					const bgOpacity = 0.25 + p * 0.35; // Fades from 0.25 to 0.60
					body.style.setProperty('--bg-opacity', `${bgOpacity}`);

					if (!prefersReducedMotion) {
						const bgTranslate = scrollY * -0.15;
						const bgScale = 1 + scrollY * 0.00015;
						body.style.setProperty('--bg-translate', `${bgTranslate}px`);
						body.style.setProperty('--bg-scale', `${bgScale}`);
					}

					// 2. Tagline sequential fades and translations
					// Line 1: Network Engineering (Always visible at start)
					const opacity1 = 1;
					let translate1 = 0;
					if (!prefersReducedMotion) {
						translate1 = p * -80; // Moves left
					}

					// Line 2: Security (Fades in between p=0.15 and p=0.50)
					const opacity2 = Math.min(1, Math.max(0, (p - 0.15) / 0.35));
					let translate2 = 0;
					if (!prefersReducedMotion) {
						translate2 = Math.max(0, p - 0.15) * 80; // Moves right
					}

					// Line 3: Automation (Fades in between p=0.45 and p=0.80)
					const opacity3 = Math.min(1, Math.max(0, (p - 0.45) / 0.35));
					let translate3 = 0;
					if (!prefersReducedMotion) {
						translate3 = Math.max(0, p - 0.45) * -120; // Moves left
					}

					// Set layout properties
					tagline.style.setProperty('--translate-1', `${translate1}px`);
					tagline.style.setProperty('--translate-2', `${translate2}px`);
					tagline.style.setProperty('--translate-3', `${translate3}px`);

					tagline.style.setProperty('--opacity-1', `${opacity1}`);
					tagline.style.setProperty('--opacity-2', `${opacity2}`);
					tagline.style.setProperty('--opacity-3', `${opacity3}`);

					// 3. Scroll indicator opacity fade out
					if (scrollIndicator) {
						const indicatorOpacity = Math.max(0, 1 - scrollY / 150);
						scrollIndicator.style.setProperty('--scroll-indicator-opacity', `${indicatorOpacity}`);
					}
				};

				window.addEventListener('scroll', handleScroll, { passive: true });
				// Trigger layout position immediately
				handleScroll();
			};

			// Initialize on mount
			initParallax();

			// Hook into Astro view transitions swap if active
			document.addEventListener('astro:after-swap', initParallax);
		</script>
	</body>
</html>
