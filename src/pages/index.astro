---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Welcome! 👋</h1>
			<p>
				Hi, I'm Chris Tran, a Network Engineer based in the San Francisco Bay Area. I'm passionate about 
				IT infrastructure, network security, and creating efficient technical solutions.
			</p>
			<p>
				This is my digital space where I share my professional journey, technical insights, and occasional 
				thoughts about technology and networking. Feel free to explore my blog posts or learn more about 
				my background and experience.
			</p>
			<div class="cta-links">
				<div class="cta-grid">
					<a href="/about" class="cta-item">
						<h3>About Me →</h3>
						<p>Learn more about my professional background and expertise</p>
					</a>
					<a href="/blog" class="cta-item">
						<h3>Blog →</h3>
						<p>Read my latest thoughts and technical articles</p>
					</a>
				</div>
			</div>
		</main>
		<Footer />
		<style>
			.cta-links {
				margin-top: 2rem;
			}
			.cta-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 1rem;
			}
			.cta-item {
				padding: 1.5rem;
				background: rgba(var(--gray-light), 0.1);
				border-radius: 8px;
				text-decoration: none;
				transition: all 0.3s ease;
			}
			.cta-item:hover {
				background: rgba(var(--gray-light), 0.2);
				transform: translateY(-2px);
			}
			.cta-item h3 {
				margin: 0;
				font-size: 1.2em;
				color: var(--accent);
			}
			.cta-item p {
				margin: 0.5rem 0 0 0;
				font-size: 0.9em;
				color: rgb(var(--gray-dark));
			}
		</style>
	</body>
</html>

