---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="home-page">
		<div class="loader-overlay" id="loader-overlay" role="status" aria-live="polite" aria-label="Loading">
			<div class="loader-content">
				<svg class="loader-network" viewBox="0 0 120 120" aria-hidden="true">
					<defs>
						<linearGradient id="loader-grad" x1="0%" y1="0%" x2="100%" y2="100%">
							<stop offset="0%" stop-color="var(--accent)" />
							<stop offset="100%" stop-color="var(--accent-dark)" />
						</linearGradient>
					</defs>
					<!-- network nodes -->
					<circle class="loader-node" cx="60" cy="60" r="6" fill="url(#loader-grad)" />
					<circle class="loader-node" cx="60" cy="20" r="5" fill="url(#loader-grad)" />
					<circle class="loader-node" cx="95" cy="45" r="5" fill="url(#loader-grad)" />
					<circle class="loader-node" cx="95" cy="95" r="5" fill="url(#loader-grad)" />
					<circle class="loader-node" cx="25" cy="95" r="5" fill="url(#loader-grad)" />
					<circle class="loader-node" cx="25" cy="45" r="5" fill="url(#loader-grad)" />
					<!-- links (draw in sequence) -->
					<line class="loader-link" x1="60" y1="60" x2="60" y2="20" />
					<line class="loader-link" x1="60" y1="60" x2="95" y2="45" />
					<line class="loader-link" x1="60" y1="60" x2="95" y2="95" />
					<line class="loader-link" x1="60" y1="60" x2="25" y2="95" />
					<line class="loader-link" x1="60" y1="60" x2="25" y2="45" />
					<!-- packet traveling the path -->
					<circle class="loader-packet" r="4" fill="#7B9EFF">
						<animateMotion dur="1s" repeatCount="1" fill="freeze" path="M60 60 L60 20 L95 45 L60 60 L95 95 L60 60 L25 95 L60 60 L25 45 Z" />
					</circle>
				</svg>
				<p class="loader-text">Establishing connection...</p>
			</div>
		</div>
		<Header />
		<main>
			<h1>Network Engineering. Security. Automation.</h1>
			<p>
				I’m Chris Tran, a San Francisco Bay Area-based engineer passionate about building infrastructure that just works. Explore my latest projects, read my technical deep-dives, or use the terminal below to query my skills directly.
			</p>
			<section class="terminal-section" aria-label="Interactive terminal">
				<div class="terminal-window" id="terminal-window">
					<div class="terminal-titlebar">
						<div class="terminal-dots">
							<span class="dot red"></span>
							<span class="dot yellow"></span>
							<span class="dot green"></span>
						</div>
						<span class="terminal-title">visitor@portfolio — bash</span>
					</div>
					<div class="terminal-body">
						<div class="terminal-output" id="term-output" role="log">
							<div class="term-line">
								<span class="term-prompt">visitor@portfolio:~$</span>type a command and press Enter. try <code>help</code>
							</div>
						</div>
						<div class="terminal-input-line">
							<span class="term-prompt term-prompt-full">visitor@portfolio:~$</span>
							<span class="term-prompt term-prompt-short" aria-hidden="true">$ </span>
							<span class="terminal-input-wrap">
								<input
									type="text"
									class="terminal-input"
									id="term-input"
									autocomplete="off"
									autocapitalize="off"
									spellcheck="false"
									aria-label="Terminal command input"
								/>
								<span class="term-cursor" aria-hidden="true"></span>
							</span>
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />
		<style>
			.loader-overlay {
				position: fixed;
				inset: 0;
				z-index: 9999;
				background: rgba(11, 16, 33, 0.96);
				display: flex;
				align-items: center;
				justify-content: center;
				transition: opacity 0.35s ease-out, visibility 0.35s ease-out;
			}
			.loader-overlay.hide {
				opacity: 0;
				visibility: hidden;
				pointer-events: none;
			}
			.loader-content {
				text-align: center;
			}
			.loader-network {
				width: 140px;
				height: 140px;
				display: block;
				margin: 0 auto 1rem;
			}
			.loader-node {
				opacity: 0;
				animation: loader-node-in 0.15s ease-out forwards;
			}
			.loader-node:nth-child(1) { animation-delay: 0s; }
			.loader-node:nth-child(2) { animation-delay: 0.08s; }
			.loader-node:nth-child(3) { animation-delay: 0.16s; }
			.loader-node:nth-child(4) { animation-delay: 0.24s; }
			.loader-node:nth-child(5) { animation-delay: 0.32s; }
			.loader-node:nth-child(6) { animation-delay: 0.4s; }
			@keyframes loader-node-in {
				to { opacity: 1; }
			}
			.loader-link {
				stroke: rgba(123, 158, 255, 0.4);
				stroke-width: 2;
				stroke-dasharray: 120;
				stroke-dashoffset: 120;
				animation: loader-link-draw 0.2s ease-out forwards;
			}
			.loader-link:nth-of-type(1) { animation-delay: 0.05s; }
			.loader-link:nth-of-type(2) { animation-delay: 0.2s; }
			.loader-link:nth-of-type(3) { animation-delay: 0.35s; }
			.loader-link:nth-of-type(4) { animation-delay: 0.5s; }
			.loader-link:nth-of-type(5) { animation-delay: 0.65s; }
			.loader-link:nth-of-type(6) { animation-delay: 0.8s; }
			@keyframes loader-link-draw {
				to { stroke-dashoffset: 0; }
			}
			.loader-packet {
				filter: drop-shadow(0 0 4px var(--accent));
			}
			.loader-text {
				margin: 0;
				font-size: 0.9rem;
				color: rgba(210, 215, 235, 0.8);
				letter-spacing: 0.05em;
			}
			.home-page {
				background-image: url('/img/network-bg.webp');
				background-size: cover;
				background-position: center;
				background-attachment: fixed;
				min-height: 100vh;
			}
			.home-page main {
				position: relative;
				background: rgba(11, 16, 33, 0.88);
				padding: 1.5rem;
				border-radius: 8px;
				margin: 1rem auto;
				max-width: 65ch;
				box-sizing: border-box;
			}
			.terminal-section {
				margin-top: 2.5rem;
			}
			.terminal-window {
				font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, monospace;
				font-size: 0.85rem;
				line-height: 1.5;
				background: #1a1d29;
				border-radius: 10px;
				overflow-x: auto;
				overflow-y: hidden;
				box-shadow: var(--box-shadow), 0 0 0 1px rgba(123, 158, 255, 0.15);
				max-width: 100%;
				min-width: 0;
			}
			.terminal-titlebar {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				padding: 0.5rem 0.75rem;
				background: #252836;
				border-bottom: 1px solid rgba(0, 0, 0, 0.3);
				cursor: text;
			}
			.terminal-dots {
				display: flex;
				gap: 6px;
			}
			.terminal-dots .dot {
				width: 10px;
				height: 10px;
				border-radius: 50%;
			}
			.terminal-dots .dot.red { background: #ff5f56; }
			.terminal-dots .dot.yellow { background: #ffbd2e; }
			.terminal-dots .dot.green { background: #27c93f; }
			.terminal-title {
				color: rgba(210, 215, 235, 0.7);
				font-size: 0.75rem;
			}
			.terminal-body {
				padding: 0.75rem 1rem;
				min-height: 210px;
				cursor: text;
			}
			.terminal-output {
				max-height: 300px;
				overflow-y: auto;
				margin-bottom: 0.5rem;
			}
			.terminal-output .term-line {
				margin-bottom: 0.25rem;
				word-break: break-word;
			}
			.terminal-output .term-line code {
				background: rgba(123, 158, 255, 0.2);
				padding: 1px 4px;
				border-radius: 3px;
			}
			.term-prompt {
				color: var(--accent);
				margin-right: 0.5rem;
			}
			.term-prompt-short {
				display: none;
			}
			.terminal-input-line {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0;
			}
			.terminal-input-wrap {
				display: inline-flex;
				align-items: center;
				flex: 1;
				min-width: 0;
			}
			.terminal-input {
				flex: none;
				width: 1ch;
				min-width: 1ch;
				max-width: 50ch;
				background: transparent;
				border: none;
				color: rgb(var(--gray-dark));
				font: inherit;
				outline: none;
				padding: 0;
			}
			.terminal-input::placeholder {
				color: rgba(210, 215, 235, 0.4);
			}
			.term-cursor {
				display: inline-block;
				width: 8px;
				height: 1.1em;
				margin-left: -1ch;
				background: var(--accent);
				animation: blink 1s step-end infinite;
				vertical-align: text-bottom;
			}
			@keyframes blink {
				50% { opacity: 0; }
			}
			.terminal-output .term-response {
				color: rgb(var(--gray));
				white-space: pre-wrap;
			}

			@media (max-width: 640px) {
				.home-page {
					overflow-x: hidden;
				}
				.home-page main {
					width: 100%;
					max-width: 100%;
					padding: 1rem;
					margin: 0.5rem 0;
					overflow-x: hidden;
				}
				.terminal-section {
					margin-top: 1.5rem;
				}
				.terminal-window {
					font-size: 0.875rem;
					border-radius: 8px;
					max-width: 100%;
				}
				.terminal-titlebar {
					padding: 0.4rem 0.6rem;
				}
				.terminal-title {
					max-width: 60%;
					overflow: hidden;
					text-overflow: ellipsis;
					white-space: nowrap;
				}
				.terminal-body {
					padding: 0.5rem 0.75rem;
					min-height: 180px;
					max-width: 100%;
					overflow-x: auto;
				}
				.terminal-output {
					max-height: 240px;
					margin-bottom: 0.4rem;
				}
				.term-prompt-full {
					display: none !important;
				}
				.term-prompt-short {
					display: inline !important;
				}
				.terminal-input-line {
					min-width: 0;
				}
				.terminal-input {
					font-size: 16px;
				}
			}
		</style>
		<script is:inline>
			document.addEventListener('DOMContentLoaded', function () {
				var loader = document.getElementById('loader-overlay');
				if (loader) {
					setTimeout(function () {
						loader.classList.add('hide');
					}, 1000);
				}

				const output = document.getElementById('term-output');
				const input = document.getElementById('term-input');
				const terminalWindow = document.getElementById('terminal-window');
				if (!output || !input) return;

				if (terminalWindow) {
					terminalWindow.addEventListener('click', function () {
						input.focus();
					});
				}

				function updateInputWidth() {
					var len = input.value.length;
					input.style.width = (len || 1) + 'ch';
				}
				updateInputWidth();
				input.addEventListener('input', updateInputWidth);

				const promptText = 'visitor@portfolio:~$';

				const commands = {
					whoami: function () {
						return 'chris\n\nNetwork Engineer in the SF Bay Area. IT infrastructure, security, and turning caffeine into configs.';
					},
					'ping skills': function () {
						return 'PING skills.chris.local (10.0.0.42) 56(84) bytes of data.\n64 bytes from skills: icmp_seq=1 ttl=64 time=0.042 ms\n--- skills.chris.local ping statistics ---\n1 packets transmitted, 1 received, 0% packet loss\n\nKey skills: networking, security, automation, and way too many tabs of documentation.';
					},
					'traceroute career': function () {
						return 'traceroute to career (192.168.1.1), 30 hops max\n 1  education.gateway (0.5 ms)\n 2  first-job.local (2 ms)\n 3  network-engineer.sf (5 ms)\n 4  * still.routing (present) *\n\nDestination reached. Next hop: whatever I\'m building next!';
					},
					help: function () {
						return 'Available commands:\n  whoami           — who is Chris?\n  ping skills      — probe my skills\n  traceroute career — path to where I am now\n  clear            — clear the screen';
					},
					clear: function () { return '__CLEAR__'; }
				};

				function appendLine(html) {
					const line = document.createElement('div');
					line.className = 'term-line';
					line.innerHTML = html;
					output.appendChild(line);
					output.scrollTop = output.scrollHeight;
				}

				function escapeHtml(s) {
					const div = document.createElement('div');
					div.textContent = s;
					return div.innerHTML;
				}

				function escapeHtmlWithBreaks(s) {
					return s.split('\n').map(escapeHtml).join('<br>');
				}

				function runCommand(cmd) {
					const trimmed = cmd.trim().toLowerCase();
					const response = commands[trimmed];
					if (response === undefined) {
						appendLine('<span class="term-prompt">' + promptText + '</span> ' + escapeHtml(cmd));
						appendLine('<span class="term-response">bash: ' + escapeHtml(trimmed) + ': command not found. Try `help`</span>');
						return;
					}
					appendLine('<span class="term-prompt">' + promptText + '</span> ' + escapeHtml(cmd));
					const result = typeof response === 'function' ? response() : response;
					if (result === '__CLEAR__') {
						output.innerHTML = '';
						return;
					}
					appendLine('<span class="term-response">' + escapeHtmlWithBreaks(result) + '</span>');
				}

				input.addEventListener('keydown', function (e) {
					if (e.key !== 'Enter') return;
					e.preventDefault();
					var cmd = input.value;
					input.value = '';
					updateInputWidth();
					runCommand(cmd);
				});

				// Only autofocus on non-mobile to avoid opening the keyboard on small screens
				if (window.matchMedia('(min-width: 641px)').matches) {
					input.focus();
				}
			});
		</script>
	</body>
</html>

