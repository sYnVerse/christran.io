---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getFeaturedProjects } from '../data/projects';
import { getCollection } from 'astro:content';

const featured = getFeaturedProjects();
const latestPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<noscript>
			<style>
				.hero-wrapper {
					height: auto !important;
				}
				.hero-section {
					position: relative !important;
					height: 90vh !important;
					min-height: 400px !important;
				}
				.scroll-indicator {
					display: none !important;
				}
			</style>
		</noscript>
		<script type="application/ld+json" is:inline>
		{
		  "@context": "https://schema.org",
		  "@type": "Person",
		  "name": "Chris Tran",
		  "jobTitle": "Network Engineer",
		  "worksFor": {
		    "@type": "Organization",
		    "name": "Auto-Chlor System"
		  },
		  "url": "https://christran.io",
		  "sameAs": [
		    "https://linkedin.com/in/synchris",
		    "https://github.com/sYnVerse"
		  ],
		  "alumniOf": [
		    {
		      "@type": "EducationalOrganization",
		      "name": "University of California, San Diego"
		    },
		    {
		      "@type": "EducationalOrganization",
		      "name": "Western Governors University"
		    }
		  ],
		  "address": {
		    "@type": "PostalAddress",
		    "addressLocality": "San Francisco Bay Area",
		    "addressRegion": "CA",
		    "addressCountry": "US"
		  }
		}
		</script>
		<style>
			.home-page {
				min-height: 100vh;
				position: relative;
			}
			/* Custom header styling on homepage for fixed glassmorphic layout */
			.home-page :global(header) {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 10;
				background: rgba(11, 16, 33, 0.4) !important;
				backdrop-filter: blur(16px);
				border-bottom: 1px solid rgba(255, 255, 255, 0.06);
				transition: background-color 0.3s ease, border-color 0.3s ease;
			}
			.home-page::before {
				content: '';
				position: fixed;
				inset: -40px; /* Prevents edge gaps during background translations */
				background-image: url('../assets/img/network-bg.webp');
				background-size: cover;
				background-position: center;
				image-rendering: -webkit-optimize-contrast;
				image-rendering: crisp-edges;
				z-index: -1;
				opacity: var(--bg-opacity, 0.25);
				will-change: transform, opacity;
				transform: translateY(var(--bg-translate, 0px)) scale(var(--bg-scale, 1));
				transition: transform 0.1s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.15s ease-out;
			}
			/* Widescreen Laptops/Desktops (16:9 / 16:10) */
			@media (min-aspect-ratio: 1.2/1) {
				.home-page::before {
					background-image: url('../assets/img/network-bg-desktop.webp');
				}
			}
			/* Ultrawide Monitors (21:9 / 32:9) */
			@media (min-aspect-ratio: 2/1) {
				.home-page::before {
					background-image: url('../assets/img/network-bg-ultrawide.webp');
				}
			}
			/* Mobile Portrait Screens */
			@media (max-width: 768px) and (orientation: portrait) {
				.home-page::before {
					background-image: url('../assets/img/network-bg-mobile.webp');
				}
			}
			/* Hero scroll pin wrapper (tracks scroll progress for sequential animation) */
			.hero-wrapper {
				height: 220vh; /* Pinned for 1.2 viewport heights */
				position: relative;
			}
			/* Full Screen Hero Section (Sticky) */
			.hero-section {
				height: 100vh;
				height: 100dvh;
				position: sticky;
				top: 0;
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
				overflow: hidden;
				padding: 2rem;
				box-sizing: border-box;
			}
			.hero-content {
				width: 100%;
				max-width: 800px;
				margin: auto 0;
			}
			.tagline-parallax {
				font-size: clamp(2rem, 9vw, 4.6rem);
				line-height: 1.1;
				margin-bottom: 0;
				font-weight: 800;
				letter-spacing: -0.03em;
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
				overflow: visible; /* Avoid clipping text scale and glow */
			}
			.tagline-line {
				display: block;
				will-change: translate, opacity, scale;
				transition: opacity 0.15s ease, scale 0.2s cubic-bezier(0.25, 1, 0.5, 1), filter 0.2s ease;
				translate: var(--translate, 0px);
				opacity: var(--opacity, 1); /* Safe fallback for non-JS users */
				cursor: default;
			}
			.line-1 {
				--translate: var(--translate-1, 0px);
				--opacity: var(--opacity-1, 1);
				background: linear-gradient(135deg, #FFFFFF 30%, var(--accent) 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
			}
			.line-2 {
				--translate: var(--translate-2, 0px);
				--opacity: var(--opacity-2, 1);
				color: #FFFFFF;
				text-shadow: 0 0 40px rgba(255, 255, 255, 0.1);
				padding-left: 2rem;
			}
			.line-3 {
				--translate: var(--translate-3, 0px);
				--opacity: var(--opacity-3, 1);
				background: linear-gradient(135deg, var(--accent) 0%, #A5C0FF 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
				padding-left: 4rem;
			}
			.tagline-line:hover {
				filter: drop-shadow(0 0 12px rgba(123, 158, 255, 0.6));
				scale: 1.02;
			}
			@media (prefers-reduced-motion: reduce) {
				.tagline-line {
					translate: none !important;
					scale: none !important;
					transition: none !important;
					will-change: auto;
				}
			}
			@media (max-width: 720px) {
				.home-page::before {
					transform: none !important;
					opacity: 0.35 !important;
					will-change: auto;
				}
				.hero-wrapper {
					height: auto !important;
				}
				.hero-section {
					position: relative !important;
					height: auto !important;
					min-height: 90vh !important;
					padding-top: 4.5rem !important;
					box-sizing: border-box !important;
				}
				.tagline-line {
					translate: none !important;
					scale: none !important;
					opacity: 1 !important;
					transition: none !important;
					will-change: auto;
				}
				.line-2 {
					padding-left: 1rem !important;
				}
				.line-3 {
					padding-left: 2rem !important;
				}
				.scroll-indicator {
					display: none !important;
				}
			}
			/* Scroll indicator */
			.scroll-indicator {
				position: absolute;
				bottom: 2rem;
				left: 50%;
				transform: translateX(-50%) translateY(calc((1 - var(--scroll-indicator-opacity, 1)) * 10px));
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.6rem;
				opacity: var(--scroll-indicator-opacity, 1);
				transition: opacity 0.2s ease, transform 0.2s ease;
				pointer-events: none;
			}
			@media (min-width: 721px) and (max-height: 680px) {
				.tagline-parallax {
					font-size: clamp(1.8rem, 8vh, 3.5rem) !important;
				}
				.scroll-indicator {
					bottom: 1.25rem !important;
				}
			}
			.scroll-text {
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.25em;
				color: var(--accent);
				font-weight: 600;
				opacity: 0.8;
			}
			.mouse-icon {
				width: 22px;
				height: 36px;
				border: 2px solid rgba(176, 186, 209, 0.4);
				border-radius: 11px;
				position: relative;
			}
			.mouse-wheel {
				width: 4px;
				height: 8px;
				background: var(--accent);
				border-radius: 2px;
				position: absolute;
				top: 6px;
				left: 50%;
				transform: translateX(-50%);
				animation: mouse-scroll-anim 1.6s infinite ease-in-out;
			}
			@keyframes mouse-scroll-anim {
				0% {
					top: 6px;
					opacity: 1;
				}
				50% {
					top: 18px;
					opacity: 0;
				}
				100% {
					top: 6px;
					opacity: 1;
				}
			}

			.home-page main {
				position: relative;
				background: rgba(11, 16, 33, 0.88);
				padding: 2.5rem 2rem;
				border-radius: 12px;
				margin: 0 auto 4rem auto;
				width: calc(100% - 2rem);
				max-width: 720px;
				box-sizing: border-box;
				box-shadow: var(--box-shadow);
				border: 1px solid rgba(255, 255, 255, 0.05);
				z-index: 2;
			}
			/* Featured section */
			.featured-section {
				margin: 2.5rem 0;
			}
			.featured-heading {
				font-size: 1.4rem;
				margin-bottom: 1.25rem;
				color: rgb(var(--black));
				position: relative;
				padding-bottom: 0.5rem;
			}
			.featured-heading::after {
				content: '';
				position: absolute;
				bottom: 0;
				left: 0;
				width: 3rem;
				height: 2px;
				background: var(--accent);
				border-radius: 1px;
			}
			.featured-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1rem;
				margin-bottom: 1rem;
			}
			.blog-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1rem;
				margin-bottom: 1.5rem;
			}
			.cta-container {
				margin-top: 1.5rem;
				display: flex;
				justify-content: flex-start;
			}
			.view-all-link {
				position: relative;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 0.65rem 1.5rem;
				border-radius: 9999px;
				background: linear-gradient(135deg, rgba(30, 35, 50, 0.95) 0%, rgba(15, 20, 35, 0.98) 100%);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				border: 1px solid rgba(123, 158, 255, 0.3);
				color: var(--accent);
				font-size: 0.9rem;
				font-weight: 600;
				text-decoration: none;
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 8px 32px rgba(0, 0, 0, 0.5);
				transition: all 0.22s cubic-bezier(0.34, 1.45, 0.64, 1);
				z-index: 1;
				overflow: visible;
			}
			.view-all-link::before,
			.view-all-link::after {
				content: "";
				position: absolute;
				left: -2px;
				top: -2px;
				width: calc(100% + 4px);
				height: calc(100% + 4px);
				border-radius: 9999px;
				z-index: -1;
				transition: opacity 0.32s ease;
				background: linear-gradient(45deg, #042f4a, #0a4d6e, #0d6b7d, #0e7490, #0891b2, #06b6d4, #22d3ee, #2dd4bf, #34d399, #5eead4, #67e8f9, #38bdf8, #0ea5e9, #0369a1, #042f4a);
				background-size: 200% auto;
				animation: pill-gradient-flow 6s linear infinite;
				pointer-events: none;
			}
			.view-all-link::after {
				filter: blur(16px);
				opacity: 0.65;
				transition: filter 0.32s ease, opacity 0.32s ease;
			}
			.view-all-link:hover {
				color: #ffffff;
				transform: scale(1.04) translateY(-2px);
				border-color: rgba(123, 158, 255, 0.6);
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), 0 12px 40px rgba(0, 0, 0, 0.6);
				opacity: 1;
			}
			.view-all-link:hover::after {
				filter: blur(24px) brightness(1.3);
				opacity: 0.9;
			}
			.view-all-link:active {
				transform: scale(0.98) translateY(0);
			}
			@keyframes pill-gradient-flow {
				0% {
					background-position: 0% 50%;
				}
				50% {
					background-position: 100% 50%;
				}
				100% {
					background-position: 0% 50%;
				}
			}
			@media (max-width: 640px) {
				.home-page main {
					padding: 1.25rem;
					margin: 1rem auto 3rem auto;
				}
				.featured-grid {
					grid-template-columns: 1fr;
					gap: 1rem;
				}
				.blog-grid {
					grid-template-columns: 1fr;
					gap: 1rem;
				}
				.featured-section {
					margin: 1.5rem 0;
				}
				.cta-container {
					justify-content: center;
				}
			}
		</style>
	</head>
	<body class="home-page">
		<Header />
		
		<div class="hero-wrapper">
			<div class="hero-section">
				<div class="hero-content">
					<h1 class="tagline-parallax" aria-label="Network Engineering, Security, Automation">
						<span class="tagline-line line-1" aria-hidden="true">Network Engineering.</span>
						<span class="tagline-line line-2" aria-hidden="true">Security.</span>
						<span class="tagline-line line-3" aria-hidden="true">Automation.</span>
					</h1>
				</div>
				
				<div class="scroll-indicator" aria-hidden="true">
					<span class="scroll-text">Scroll to explore</span>
					<div class="mouse-icon">
						<span class="mouse-wheel"></span>
					</div>
				</div>
			</div>
		</div>

		<main>
			<p>
				I’m <strong>Chris Tran</strong>, a <strong>San Francisco Bay Area Network Engineer</strong> specializing in IT infrastructure, network security, virtualization, and automation. Currently working at <strong>Auto-Chlor System</strong> and pursuing my M.S. in IT Management at <strong>WGU</strong>, I hold a B.S. in Mathematics-Computer Science from the <strong>University of California, San Diego</strong> (<strong>UCSD</strong>). I am passionate about building reliable infrastructure that just works. Explore my latest projects, read my technical deep-dives, or click the terminal icon in the bottom right to query my skills directly.
			</p>

			<section class="featured-section" aria-label="Featured work">
				<h2 class="featured-heading">Featured Work</h2>
				<div class="featured-grid">
					{featured.map((project) => (
						<ProjectCard project={project} compact />
					))}
				</div>
				<div class="cta-container">
					<a href="/portfolio" class="view-all-link">View all projects →</a>
				</div>
			</section>

			<section class="featured-section" aria-label="Latest blog posts">
				<h2 class="featured-heading">Latest Deep-Dives</h2>
				<div class="blog-grid">
					{latestPosts.map((post) => (
						<BlogCard post={post} />
					))}
				</div>
				<div class="cta-container">
					<a href="/blog" class="view-all-link">View all posts →</a>
				</div>
			</section>
		</main>
		<Footer />
		
		<script>
			let cleanupParallax = null;

			const initParallax = () => {
				if (cleanupParallax) {
					cleanupParallax();
				}

				const tagline = document.querySelector('.tagline-parallax');
				const wrapper = document.querySelector('.hero-wrapper');
				const scrollIndicator = document.querySelector('.scroll-indicator');
				const body = document.body;
				if (!tagline || !wrapper) return;

				const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

				// Cache layout values to prevent layout thrashing on scroll
				let viewportHeight = window.innerHeight;
				let wrapperHeight = wrapper.offsetHeight;
				let scrollRange = wrapperHeight - viewportHeight;
				let translateMultiplier = 1;

				const handleResize = () => {
					viewportHeight = window.innerHeight;
					wrapperHeight = wrapper.offsetHeight;
					scrollRange = wrapperHeight - viewportHeight;
					
					const width = window.innerWidth;
					if (width <= 480) {
						translateMultiplier = 0.25; // 25% translation on small mobile
					} else if (width <= 768) {
						translateMultiplier = 0.5;  // 50% translation on tablet/medium mobile
					} else {
						translateMultiplier = 1;    // 100% translation on desktop
					}
				};

				// Run immediately to calculate on load
				handleResize();

				let targetScrollY = window.scrollY;
				let currentScrollY = window.scrollY;
				let rafId = null;

				const updateStyles = () => {
					// Smooth interpolation (lerp)
					const diff = targetScrollY - currentScrollY;
					if (Math.abs(diff) < 0.05) {
						currentScrollY = targetScrollY;
					} else {
						currentScrollY += diff * 0.15; // Smooth deceleration factor
					}

					// Calculate scroll progress (0 to 1) inside the pinned region using smoothed currentScrollY
					const p = scrollRange > 0 ? Math.min(1, Math.max(0, currentScrollY / scrollRange)) : 0;

					// Smoothly ease out progress as we reach the boundaries (cubic ease-out)
					const pEased = 1 - Math.pow(1 - p, 3);

					// 1. Background vertical scroll parallax, scale, and fade-in using eased progress
					const bgOpacity = 0.25 + pEased * 0.35; // Fades from 0.25 to 0.60
					body.style.setProperty('--bg-opacity', `${bgOpacity}`);

					if (!prefersReducedMotion) {
						const bgTranslate = currentScrollY * -0.15;
						const bgScale = 1 + currentScrollY * 0.00015;
						body.style.setProperty('--bg-translate', `${bgTranslate}px`);
						body.style.setProperty('--bg-scale', `${bgScale}`);
					}

					// 2. Tagline sequential fades and translations
					// Line 1: Network Engineering (Always visible at start)
					const opacity1 = 1;
					let translate1 = 0;
					if (!prefersReducedMotion) {
						translate1 = pEased * -80 * translateMultiplier; // Moves left
					}

					// Line 2: Security (Fades in between pEased=0.15 and pEased=0.50)
					const pLine2 = Math.min(1, Math.max(0, (pEased - 0.15) / 0.35));
					const opacity2 = pLine2;
					let translate2 = 0;
					if (!prefersReducedMotion) {
						translate2 = pLine2 * 80 * translateMultiplier; // Moves right
					}

					// Line 3: Automation (Fades in between pEased=0.45 and pEased=0.80)
					const pLine3 = Math.min(1, Math.max(0, (pEased - 0.45) / 0.35));
					const opacity3 = pLine3;
					let translate3 = 0;
					if (!prefersReducedMotion) {
						translate3 = pLine3 * -120 * translateMultiplier; // Moves left
					}

					// Set layout properties
					tagline.style.setProperty('--translate-1', `${translate1}px`);
					tagline.style.setProperty('--translate-2', `${translate2}px`);
					tagline.style.setProperty('--translate-3', `${translate3}px`);

					tagline.style.setProperty('--opacity-1', `${opacity1}`);
					tagline.style.setProperty('--opacity-2', `${opacity2}`);
					tagline.style.setProperty('--opacity-3', `${opacity3}`);

					// 3. Scroll indicator opacity fade out
					if (scrollIndicator) {
						const indicatorOpacity = Math.max(0, 1 - currentScrollY / 150);
						scrollIndicator.style.setProperty('--scroll-indicator-opacity', `${indicatorOpacity}`);
					}

					// Continue loop if not settled
					if (currentScrollY !== targetScrollY) {
						rafId = requestAnimationFrame(updateStyles);
					} else {
						rafId = null;
					}
				};

				const handleScroll = () => {
					const width = window.innerWidth;
					if (width <= 720) {
						// Reset properties for mobile so they don't override the mobile CSS styles
						body.style.removeProperty('--bg-opacity');
						body.style.removeProperty('--bg-translate');
						body.style.removeProperty('--bg-scale');
						tagline.style.removeProperty('--translate-1');
						tagline.style.removeProperty('--translate-2');
						tagline.style.removeProperty('--translate-3');
						tagline.style.removeProperty('--opacity-1');
						tagline.style.removeProperty('--opacity-2');
						tagline.style.removeProperty('--opacity-3');
						if (scrollIndicator) {
							scrollIndicator.style.removeProperty('--scroll-indicator-opacity');
						}
						if (rafId) {
							cancelAnimationFrame(rafId);
							rafId = null;
						}
						return;
					}

					targetScrollY = window.scrollY;
					if (!rafId) {
						rafId = requestAnimationFrame(updateStyles);
					}
				};

				const onScroll = handleScroll;
				const onResize = handleResize;

				window.addEventListener('scroll', onScroll, { passive: true });
				window.addEventListener('resize', onResize, { passive: true });

				cleanupParallax = () => {
					window.removeEventListener('scroll', onScroll);
					window.removeEventListener('resize', onResize);
					if (rafId) {
						cancelAnimationFrame(rafId);
					}
				};

				// Trigger layout position immediately
				handleScroll();
			};

			// Initialize on mount
			initParallax();

			// Hook into Astro view transitions swap if active
			document.addEventListener('astro:after-swap', initParallax);
		</script>
	</body>
</html>
