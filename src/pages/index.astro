				background-position: center;
				background-attachment: fixed;
				min-height: 100vh;
			}
			.home-page main {
				position: relative;
				background: rgba(11, 16, 33, 0.88);
				padding: 1.5rem;
				border-radius: 8px;
				margin: 1rem auto;
				max-width: 65ch;
			}
			.cta-links {
				margin-top: 2rem;
			}
			.cta-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 1rem;
			}
			.cta-item {
				padding: 1.5rem;
				background: rgba(var(--gray-light), 0.1);
				border-radius: 8px;
				text-decoration: none;
				transition: all 0.3s ease;
			}
			.cta-item:hover {
				background: rgba(var(--gray-light), 0.2);
				transform: translateY(-2px);
			}
			.cta-item h3 {
				margin: 0;
				font-size: 1.2em;
				color: var(--accent);
			}
			.cta-item p {
				margin: 0.5rem 0 0 0;
				font-size: 0.9em;
				color: rgb(var(--gray-dark));
			}
		</style>
	</body>
</html>

