---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Resume | Chris Tran"
			description="View Chris Tran's resume — Network Engineer specializing in IT infrastructure, security, and automation."
		/>
	</head>
	<body>
		<Header />
		<main class="resume-page">
			<div class="resume-container">
				<div class="resume-header">
					<h1>Resume</h1>
					<a href="/resume.pdf" download class="download-link" target="_blank" rel="noopener noreferrer">
						Download PDF
					</a>
				</div>
				<iframe
					src="/resume.pdf#view=FitH"
					title="Chris Tran's Resume"
					class="resume-embed"
				></iframe>
			</div>
		</main>
		<Footer />
		<style>
			.resume-page {
				min-height: calc(100vh - 200px);
				padding: 1rem;
				box-sizing: border-box;
			}
			.resume-container {
				max-width: 900px;
				margin: 0 auto;
				background: rgba(11, 16, 33, 0.88);
				border-radius: 8px;
				padding: 1.5rem;
				box-shadow: var(--box-shadow);
			}
			.resume-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-bottom: 1rem;
			}
			.resume-header h1 {
				margin: 0;
				font-size: 1.75rem;
				color: rgb(var(--gray-dark));
			}
			.download-link {
				padding: 0.5rem 1rem;
				background: rgba(123, 158, 255, 0.2);
				color: var(--accent);
				text-decoration: none;
				border-radius: 6px;
				font-size: 0.9rem;
				transition: background 0.2s ease, color 0.2s ease;
			}
			.download-link:hover {
				background: rgba(123, 158, 255, 0.35);
				color: #9bb3ff;
			}
			.resume-embed {
				width: 100%;
				height: 85vh;
				min-height: 600px;
				border: 1px solid rgba(123, 158, 255, 0.15);
				border-radius: 6px;
				background: #fff;
			}
			@media (max-width: 640px) {
				.resume-page {
					padding: 0.5rem;
				}
				.resume-container {
					padding: 1rem;
				}
				.resume-embed {
					min-height: 500px;
					height: 75vh;
				}
			}
		</style>
	</body>
</html>
