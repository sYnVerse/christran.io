---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const firstPost = posts[0]; // Get only the first post
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			.post-container {
				max-width: 100%;
				margin: 0 auto;
				padding: 0;
			}
			.post-link {
				text-decoration: none;
				display: block;
				text-align: center;
			}
			.post-image {
				width: 100%;
				max-width: 720px;
				height: auto;
				border-radius: 12px;
				margin-bottom: 1rem;
				transition: 0.2s ease;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1.2;
				font-size: 2.369rem;
			}
			.date {
				margin: 0.5rem 0 0 0;
				color: rgb(var(--gray));
			}
			.post-link:hover .title,
			.post-link:hover .date {
				color: rgb(var(--accent));
			}
			.post-link:hover .post-image {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				.title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<div class="post-container">
					<a href={`/blog/${firstPost.id}/`} class="post-link">
						<img 
							class="post-image"
							width={720} 
							height={360} 
							src={firstPost.data.heroImage} 
							alt="" 
						/>
						<h2 class="title">{firstPost.data.title}</h2>
						<p class="date">
							<FormattedDate date={firstPost.data.pubDate} />
						</p>
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
