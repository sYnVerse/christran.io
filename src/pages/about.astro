			.stack-card {
				background: rgba(20, 27, 49, 0.75);
				border: 1px solid rgba(123, 158, 255, 0.18);
				border-radius: 12px;
				padding: 1.25rem;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
