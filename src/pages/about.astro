				background: rgba(14, 165, 233, 0.2);
				border: 1.5px solid rgba(56, 189, 248, 0.6);
				color: #38bdf8;
			}
			.stack-arrow-badge {
				background: rgba(16, 185, 129, 0.2);
				border: 1.5px solid rgba(52, 211, 153, 0.6);
				color: #34d399;
