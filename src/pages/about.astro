			.btn-dossier {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				padding: 0.55rem 0.95rem;
				border-radius: 8px;
				font-size: 0.85rem;
				font-weight: 600;
				text-decoration: none;
				background: rgba(123, 158, 255, 0.08);
				border: 1px solid rgba(123, 158, 255, 0.2);
				color: var(--accent);
