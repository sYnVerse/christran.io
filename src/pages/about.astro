	<body>
		<Header />
		<main class="about-page">
			<div class="about-container">

				<!-- Row 0: NOC Telemetry Status Bar -->
				<header class="noc-telemetry-bar" aria-label="Systems telemetry banner">
					<div class="telemetry-node">
						<span class="status-ping" aria-hidden="true">
							<span class="status-ping-ring"></span>
							<span class="status-ping-dot"></span>
						</span>
						<span class="telemetry-label">NODE:</span>
						<span class="telemetry-val">CHRIS-TRAN-SFO-01</span>
					</div>
					<div class="telemetry-tags">
						<span class="telemetry-item"><span class="k">ROLE:</span> <strong class="v">NET_ENGINEER</strong></span>
						<span class="telemetry-item"><span class="k">SITES:</span> <strong class="v-accent">70+ ONLINE</strong></span>
						<span class="telemetry-item"><span class="k">DATA_CENTERS:</span> <strong class="v-accent">2 ACTIVE</strong></span>
						<span class="telemetry-item"><span class="k">CERT_STACK:</span> <strong class="v-cios">CIOS_VERIFIED</strong></span>
					</div>
				</header>

				<!-- Row 1: Bento Grid — Profile Hero (Left) + 2x2 Impact Grid (Right) -->
				<section class="bento-row bento-hero-row" aria-label="Profile summary and impact telemetry">
					<!-- Hero Profile Dossier Card -->
					<div class="bento-card hero-dossier-card">
						<div class="dossier-top">
							<div class="avatar-container">
								<div class="avatar-glow-ring"></div>
								<Image
									src={profileImg}
									alt="Chris Tran - Network Engineer"
									width={160}
									height={160}
									quality={90}
									format="webp"
									class="avatar-img"
								/>
								<span class="avatar-badge" title="Status: Online & In Service">🟢</span>
							</div>
							<div class="dossier-intro">
								<div class="dossier-tag">OPERATOR // DOSSIER</div>
								<h1 class="dossier-name">Chris Tran</h1>
								<p class="dossier-title">Network Engineer <span class="dossier-at">@ Auto-Chlor System</span></p>
								<p class="dossier-tagline">Systems, packets, and the logical architecture that connects them.</p>
							</div>
						</div>

						<p class="dossier-bio">
							Applying a <strong>Mathematics & Computer Science</strong> foundation from <strong>UC San Diego</strong> to enterprise infrastructure, multi-site network architecture, and proactive automation. Currently pursuing an <strong>M.S. in IT Management</strong> at <strong>WGU</strong>.
						</p>

						<div class="dossier-meta-chips">
							<span class="meta-chip">📍 SF Bay Area</span>
							<span class="meta-chip">🎓 B.S. Math-CS (UCSD)</span>
							<span class="meta-chip">🎓 M.S. ITM (WGU '27)</span>
							<span class="meta-chip chip-highlight">🛡️ CompTIA CIOS Stack</span>
						</div>

						<div class="dossier-actions">
							<a href="mailto:career@christran.io" class="btn-dossier btn-primary">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
								Email Me
							</a>
							<a href="https://linkedin.com/in/synchris" target="_blank" rel="noopener noreferrer" class="btn-dossier">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
								LinkedIn
							</a>
							<a href="https://github.com/sYnVerse" target="_blank" rel="noopener noreferrer" class="btn-dossier">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
								GitHub
							</a>
							<a href="/resume" class="btn-dossier btn-resume">
								<span>Resume</span>
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
