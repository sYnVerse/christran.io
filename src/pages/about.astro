			.impact-value {
				font-size: 2.1rem;
				font-weight: 800;
				color: #FFFFFF;
				margin: 0.4rem 0 0.1rem 0;
				letter-spacing: -0.03em;
				line-height: 1.1;
			}
			.impact-subtext {
				font-size: 0.8rem;
				color: rgb(var(--gray));
			}
			.accent-blue .impact-value { color: #60a5fa; }
			.accent-emerald .impact-value { color: #34d399; }
			.accent-emerald .impact-badge { background: rgba(16, 185, 129, 0.2); color: #34d399; border-color: rgba(52, 211, 153, 0.4); }
			.accent-cyan .impact-value { color: #38bdf8; }
			.accent-indigo .impact-value { color: #a5b4fc; }

			/* Row 2: Certifications Showcase & Stack Flow */
			.certs-showcase-section {
				background: linear-gradient(180deg, rgba(15, 23, 42, 0.85) 0%, rgba(11, 16, 33, 0.9) 100%);
