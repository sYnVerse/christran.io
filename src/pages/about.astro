			/* Secondary Certs Grid */
			.secondary-certs-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 0.85rem;
				border-top: 1px solid rgba(123, 158, 255, 0.12);
				padding-top: 1.5rem;
			}
			.secondary-certs-title {
				font-size: 0.92rem;
				font-weight: 700;
				color: #FFFFFF;
			}
			.secondary-certs-note {
				font-size: 0.74rem;
				color: rgb(var(--gray));
			}
			.secondary-certs-grid {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 1rem;
			}
			.secondary-cert-card {
				background: rgba(15, 20, 38, 0.65);
				border: 1px solid rgba(123, 158, 255, 0.12);
