			.sec-verify-btn:hover {
				color: #FFFFFF;
				text-decoration: underline;
			}
			.roadmap-badge-label {
				font-size: 0.72rem;
				font-weight: 700;
				color: #fbbf24;
			}

			/* Row 3: Interactive Story Console */
			.console-header-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				flex-wrap: wrap;
				gap: 1rem;
				margin-bottom: 1.5rem;
				border-bottom: 1px solid rgba(123, 158, 255, 0.12);
				padding-bottom: 1rem;
			}
			.console-title-group {
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}
			.console-prompt-indicator {
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.85rem;
				font-weight: 800;
				color: #38bdf8;
			}
			.console-heading {
				font-size: 1.45rem;
				font-weight: 800;
				color: #FFFFFF;
				margin: 0;
