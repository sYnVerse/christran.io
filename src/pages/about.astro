			.btn-primary {
				background: var(--accent);
				color: #0B1021;
				border-color: var(--accent);
			}
			.btn-primary:hover {
				background: #9bb3ff;
				color: #0B1021;
				box-shadow: 0 0 16px rgba(123, 158, 255, 0.4);
			}
			.btn-resume {
				border-color: rgba(56, 189, 248, 0.4);
				color: #38bdf8;
			}

			/* 2x2 Impact Grid */
			.impact-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1rem;
			}
			.impact-card {
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				padding: 1.35rem;
				background: rgba(15, 20, 38, 0.75);
			}
			.impact-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 0.5rem;
			}
			.impact-label {
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: rgb(var(--gray));
				font-weight: 700;
