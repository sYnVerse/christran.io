const storyChapters = [
	{
		id: 'chapter-01',
		tabLabel: '01_packets_logic.md',
		title: 'The Packets & The Logic',
		summary: 'How a Mathematics-CS foundation shapes deterministic network architecture.',
		content: [
			'I’ve always believed that the best networks are the ones you never notice. They are the invisible arteries of modern business—quietly routing data, securing systems, and enabling seamless collaboration across distributed sites.',
			'My approach to systems and network engineering is heavily shaped by my background in Mathematics and Computer Science at UC San Diego. Instead of viewing systems purely as physical hardware or disjointed configuration files, I see them as graphs, algorithms, and deterministic flow systems. This mathematical lens helps me model complex traffic routing, predict bottleneck behaviors, and approach security hardening with structural rigor.',
		],
		takeaways: ['Graph Theory & Discrete Topology', 'Traffic Flow Modeling', 'Algorithmic Bottleneck Mitigation'],
	},
	{
		id: 'chapter-02',
		tabLabel: '02_enterprise_scale.md',
		title: 'From Support to Enterprise Infrastructure',
		summary: 'Multi-site scale, Fortinet security, and 24/7 reliability across 70+ locations.',
		content: [
			'Throughout my career, I’ve had the privilege of working in environments ranging from municipal public services to tech giants, including Microsoft, Amazon, and Santa Clara County. At Santa Clara County, I individually certified and deployed 1,200+ iPads and election hardware across 100+ polling centers—instilling an unyielding appreciation for strict SLA management, operational discipline, and bulletproof deployments.',
			'Currently, I serve as a Network Engineer at Auto-Chlor System, where I was promoted after demonstrating a track record for scalable infrastructure design and proactive automation. Today, I oversee enterprise networking across 70+ remote sites and 2 on-premises data centers, leading Fortinet firewall administration (FortiGate, FortiManager, FortiAnalyzer), VPN/cloud connectivity, physical server hosts, and central tier-3 escalations.',
		],
		takeaways: ['70+ Remote Branch Sites', '2 On-Premises Data Centers', 'Fortinet Security Fabric (Gate/Manager/Analyzer)'],
	},
	{
		id: 'chapter-03',
		tabLabel: '03_automation_homelab.md',
		title: 'Automation & The Enterprise Homelab',
		summary: 'If it repeats three times, automate it. Bridging work with a Dell PowerEdge lab.',
		content: [
			'To me, a manual task repeated more than three times is a bug. I actively write PowerShell, Python, and Bash scripts to automate fleet configurations, audit security baselines, and manage enterprise mobile devices via Samsung Knox Suite (combining Knox Mobile Enrollment for touchless provisioning and Knox Manage for MDM).',
			'This passion for building and tweaking doesn’t stop when I log off. In my spare time, I design and run an Enterprise Home Lab built on enterprise Dell PowerEdge servers. It serves as my dedicated proving ground for virtualization (Proxmox VE & Hyper-V), container orchestration (Docker & Kubernetes testing), pfSense firewalls, isolated VLANs, and automated ZFS storage pools.',
		],
		takeaways: ['Samsung Knox MDM & Fleet Scripting', 'Proxmox VE & ZFS Self-Healing Storage', 'pfSense & Multi-VLAN Isolation'],
	},
	{
		id: 'chapter-04',
		tabLabel: '04_strategic_growth.md',
		title: 'Strategic Growth & Governance',
		summary: 'Aligning packets and infrastructure with executive IT governance.',
		content: [
			'Technology is only half the equation; the other half is understanding how it serves organizational goals. To bridge the gap between technical design and business strategy, I am pursuing my M.S. in Information Technology Management at Western Governors University (expected 2027).',
			'Combined with ITIL 4 Foundation principles and my newly unlocked CompTIA IT Operations Specialist (CIOS) certification, my goal is to ensure that every server I deploy or firewall policy I commit directly reinforces governance, risk management, and overall operational efficiency.',
		],
		takeaways: ['M.S. IT Management (WGU 2027)', 'ITIL 4 Service Value System', 'Risk & Regulatory Governance'],
	},
];

