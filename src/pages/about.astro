			}
			.tag-cios {
				border-color: rgba(52, 211, 153, 0.3);
				color: #d1fae5;
			}
			.cert-action-wrap {
				border-top: 1px solid rgba(123, 158, 255, 0.1);
				padding-top: 0.75rem;
			}
			.cert-verify-link {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				font-size: 0.78rem;
				font-weight: 600;
				color: var(--accent);
				text-decoration: none;
