				box-shadow: 0 0 24px rgba(56, 189, 248, 0.18);
			}
			.cert-cios-unlocked {
				border: 2px solid rgba(52, 211, 153, 0.65);
				background: linear-gradient(165deg, rgba(16, 185, 129, 0.12) 0%, rgba(15, 23, 42, 0.9) 100%);
				box-shadow: 0 0 32px rgba(16, 185, 129, 0.22);
			}
			.cert-card-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 0.85rem;
