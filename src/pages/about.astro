			// WAI-ARIA tabs pattern: roving tabindex, automatic activation,
			// arrow keys move between tabs and Home/End jump to the ends.
			document.addEventListener('DOMContentLoaded', function () {
				function setupTabs(tabs, panels, keys) {
					function select(idx, moveFocus) {
						tabs.forEach(function (t, i) {
							const isActive = i === idx;
							t.classList.toggle('active', isActive);
							t.setAttribute('aria-selected', isActive ? 'true' : 'false');
							t.setAttribute('tabindex', isActive ? '0' : '-1');
						});
						panels.forEach(function (p, i) {
							p.classList.toggle('active', i === idx);
						});
						if (moveFocus) tabs[idx].focus();
					}

					tabs.forEach(function (tab, i) {
						tab.addEventListener('click', function () {
							select(i, false);
						});
						tab.addEventListener('keydown', function (e) {
							let next = null;
							if (keys.next.indexOf(e.key) !== -1) next = (i + 1) % tabs.length;
							else if (keys.prev.indexOf(e.key) !== -1) next = (i - 1 + tabs.length) % tabs.length;
							else if (e.key === 'Home') next = 0;
							else if (e.key === 'End') next = tabs.length - 1;
							if (next === null) return;
							e.preventDefault();
							select(next, true);
						});
					});
				}

				// Story chapter tabs
				setupTabs(
					Array.from(document.querySelectorAll('.console-tab-btn')),
					Array.from(document.querySelectorAll('.story-panel')),
					{ next: ['ArrowRight', 'ArrowDown'], prev: ['ArrowLeft', 'ArrowUp'] }
				);

				// Traceroute hop tabs
				setupTabs(
					Array.from(document.querySelectorAll('.hop-node-btn')),
					Array.from(document.querySelectorAll('.hop-detail-panel')),
					{ next: ['ArrowRight'], prev: ['ArrowLeft'] }
				);
			});
		</script>

