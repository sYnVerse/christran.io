				flex-wrap: wrap;
				gap: 0.5rem;
			}
			.meta-chip {
				padding: 0.28rem 0.65rem;
				border-radius: 6px;
				background: rgba(30, 35, 50, 0.6);
				border: 1px solid rgba(123, 158, 255, 0.16);
				font-size: 0.76rem;
				color: rgb(var(--gray-dark));
