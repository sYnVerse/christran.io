---
import HeaderLink from './HeaderLink.astro';
import SearchModal from './SearchModal.astro';
import LoaderOverlay from './LoaderOverlay.astro';
---

<header>
	<nav class="nav" aria-label="Main navigation">
		<h2><a href="/">Chris Tran</a></h2>

		<button
			type="button"
			class="hamburger"
			aria-label="Toggle menu"
			aria-expanded="false"
			aria-controls="nav-menu"
			id="hamburger-btn"
		>
			<span class="hamburger-box">
				<span class="hamburger-inner"></span>
			</span>
		</button>

		<div id="nav-menu" class="nav-menu">
			<div class="nav-menu-inner">
				<div class="internal-links">
					<HeaderLink href="/">Home</HeaderLink>
					<HeaderLink href="/blog">Blog</HeaderLink>
					<HeaderLink href="/portfolio">Portfolio</HeaderLink>
					<HeaderLink href="/about">About</HeaderLink>
				</div>
				<button class="search-trigger search-trigger-btn" aria-label="Open search" title="Search (Ctrl+K)">
					<svg class="search-trigger-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="11" cy="11" r="8"></circle>
						<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
					</svg>
					<span class="search-trigger-text">Search</span>
				</button>
				<noscript>
					<form action="https://duckduckgo.com/" method="get" class="search-fallback-form">
						<input type="hidden" name="sites" value="christran.io" />
						<input type="text" name="q" placeholder="Search..." required class="search-fallback-input" />
						<button type="submit" class="search-fallback-btn" aria-label="Search">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<circle cx="11" cy="11" r="8"></circle>
								<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
							</svg>
						</button>
					</form>
				</noscript>
				<script is:inline>
					(function() {
						var isMac = /Mac|iPod|iPhone|iPad/.test(navigator.platform || navigator.userAgent || '');
						var btn = document.currentScript.previousElementSibling;
						if (btn) {
							btn.setAttribute('title', isMac ? 'Search (⌘K)' : 'Search (Ctrl+K)');
						}
					})();
				</script>
			</div>
		</div>
	</nav>
	<SearchModal />
	<LoaderOverlay />
	<noscript>
		<style>
			/* Disable hamburger button since it won't toggle anything */
			.hamburger {
				display: none !important;
			}
			/* Hide the JS search button */
			.search-trigger-btn {
				display: none !important;
			}
			/* Ensure mobile menu is fully expanded and visible */
			@media (max-width: 720px) {
				.nav-menu {
					display: grid !important;
					grid-template-rows: 1fr !important;
					pointer-events: auto !important;
					visibility: visible !important;
					background: var(--background) !important;
					border-radius: 0.5em !important;
					box-shadow: var(--box-shadow) !important;
					border: 1px solid rgba(255, 255, 255, 0.08) !important;
					margin-top: 0.5em !important;
				}
				.internal-links {
					opacity: 1 !important;
					transform: translateY(0) !important;
				}
			}
		</style>
	</noscript>
</header>

<script>
	const btn = document.getElementById('hamburger-btn');
	const menu = document.getElementById('nav-menu');
	if (btn && menu) {
		const updateAria = () => {
			const isMobile = window.innerWidth <= 720;
			if (isMobile) {
				const isOpen = btn.getAttribute('aria-expanded') === 'true';
				menu.setAttribute('aria-hidden', String(!isOpen));
			} else {
				menu.removeAttribute('aria-hidden');
			}
		};

		// Run immediately and on resize
		updateAria();
		window.addEventListener('resize', updateAria);

		btn.addEventListener('click', () => {
			const isOpen = btn.getAttribute('aria-expanded') === 'true';
			btn.setAttribute('aria-expanded', String(!isOpen));
			menu.setAttribute('aria-hidden', String(isOpen));
			menu.classList.toggle('nav-menu--open');
			btn.classList.toggle('hamburger--active');
		});
		// Close menu when a nav link or search trigger is clicked
		menu.querySelectorAll('a, .search-trigger').forEach((link) => {
			link.addEventListener('click', () => {
				btn.setAttribute('aria-expanded', 'false');
				menu.setAttribute('aria-hidden', 'true');
				menu.classList.remove('nav-menu--open');
				btn.classList.remove('hamburger--active');
			});
		});
	}
</script>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: transparent;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	nav h2 a,
	nav h2 a.active {
		text-decoration: none;
		color: rgb(var(--black));
		padding: 0.5em 0;
		display: inline-block;
	}
	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--gray-dark));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
		color: var(--accent);
	}
	nav a:hover {
		color: var(--accent);
	}

	/* Hamburger: hidden on desktop */
	.hamburger {
		display: none;
		padding: 0.5em;
		margin: 0.25em 0;
		background: transparent;
		border: none;
		cursor: pointer;
		color: rgb(var(--gray-dark));
	}
	.hamburger:hover {
		color: var(--accent);
	}
	.hamburger-box {
		display: inline-block;
		width: 1.5em;
		height: 1em;
		position: relative;
	}
	.hamburger-inner {
		display: block;
		width: 100%;
		height: 3px;
		background: currentColor;
		border-radius: 2px;
		position: absolute;
		left: 0;
		top: 50%;
		transform: translateY(-50%);
		transition: transform 0.25s ease, opacity 0.2s ease;
	}
	.hamburger-inner::before,
	.hamburger-inner::after {
		content: '';
		display: block;
		width: 100%;
		height: 3px;
		background: currentColor;
		border-radius: 2px;
		position: absolute;
		left: 0;
		transition: transform 0.3s ease;
	}
	.hamburger-inner::before {
		top: -6px;
	}
	.hamburger-inner::after {
		top: 6px;
	}
	.hamburger--active .hamburger-inner {
		transform: translateY(-50%) rotate(225deg);
	}
	.hamburger--active .hamburger-inner::before {
		transform: translateY(6px) rotate(90deg);
	}
	.hamburger--active .hamburger-inner::after {
		transform: translateY(-6px) rotate(90deg);
	}

	/* Desktop: solid header and inline nav menu */
	@media (min-width: 721px) {
		header {
			background: var(--background);
		}
		.nav-menu {
			visibility: visible !important;
		}
	}
	.nav-menu {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.nav-menu-inner {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.internal-links {
		display: flex;
		align-items: center;
	}
	/* Search trigger button styles */
	.search-trigger-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.5rem;
		width: 38px;
		height: 38px;
		background: rgba(30, 35, 50, 0.5);
		border: 1px solid rgba(123, 158, 255, 0.15);
		border-radius: 8px;
		color: rgb(var(--gray-dark));
		cursor: pointer;
		transition: all 0.2s ease;
		margin: 0 0.5em;
	}

	.search-trigger-btn:hover {
		border-color: var(--accent);
		background: rgba(123, 158, 255, 0.08);
		color: #ffffff;
	}

	.search-trigger-icon {
		opacity: 0.7;
		flex-shrink: 0;
	}

	.search-trigger-btn:hover .search-trigger-icon {
		color: var(--accent);
		opacity: 1;
	}

	.search-trigger-text {
		display: none;
	}

	@media (max-width: 720px) {
		header {
			padding-top: 0.5em;
			padding-bottom: 0.5em;
		}
		.hamburger {
			display: inline-flex;
			align-items: center;
			justify-content: center;
		}

		.nav-menu {
			display: grid;
			width: 100%;
			grid-template-rows: 0fr;
			overflow: hidden;
			transition: grid-template-rows 0.35s ease-out, visibility 0.35s step-end;
			pointer-events: none;
			visibility: hidden;
		}
		.nav-menu--open {
			grid-template-rows: 1fr;
			pointer-events: auto;
			visibility: visible;
			transition: grid-template-rows 0.35s ease-out, visibility 0.35s step-start;
			/* Dark panel to match site theme */
			background: var(--background);
			border-radius: 0.5em;
			box-shadow: var(--box-shadow);
			border: 1px solid rgba(255, 255, 255, 0.08);
			margin-top: 0.5em;
		}
		.nav-menu--open .internal-links a,
		.nav-menu--open .internal-links a:hover,
		.nav-menu--open .internal-links a.active {
			color: var(--accent);
		}
		.nav-menu-inner {
			min-height: 0;
			overflow: hidden;
			display: flex;
			flex-direction: column;
			align-items: stretch;
			width: 100%;
		}
		.nav-menu-inner > .internal-links {
			min-height: 0;
			overflow: hidden;
		}
		.internal-links {
			flex-direction: column;
			align-items: stretch;
			padding: 0.5em 0 0.5em;
			opacity: 0;
			transform: translateY(-8px);
			transition: opacity 0.3s ease 0.05s, transform 0.25s ease 0.05s;
		}
		.nav-menu--open .internal-links {
			opacity: 1;
			transform: translateY(0);
		}
		.nav-menu a {
			padding: 0.6em 0.5em;
		}

		.search-trigger-btn {
			margin: 0.5rem 0.5rem 1rem;
			padding: 0.6rem 1rem;
			width: auto;
			height: auto;
			justify-content: center;
			opacity: 0;
			transform: translateY(-8px);
			transition: opacity 0.3s ease 0.08s, transform 0.25s ease 0.08s;
			display: inline-flex;
			gap: 0.5em;
		}
		.nav-menu--open .search-trigger-btn {
			opacity: 1;
			transform: translateY(0);
		.search-trigger-text {
			display: inline;
			font-weight: 500;
		}
	}

	/* Fallback search form styles */
	.search-fallback-form {
		display: inline-flex;
		align-items: center;
		background: rgba(30, 35, 50, 0.5);
		border: 1px solid rgba(123, 158, 255, 0.15);
		border-radius: 8px;
		padding: 2px 6px;
		margin: 0 0.5em;
		transition: border-color 0.2s ease, background-color 0.2s ease;
	}
	.search-fallback-form:focus-within {
		border-color: var(--accent);
		background: rgba(123, 158, 255, 0.08);
	}
	.search-fallback-input {
		background: transparent;
		border: none;
		outline: none;
		color: #ffffff;
		font-family: inherit;
		font-size: 0.85rem;
		padding: 4px 8px;
		width: 100px;
		transition: width 0.2s ease;
	}
	.search-fallback-input:focus {
		width: 140px;
	}
	.search-fallback-input::placeholder {
		color: rgba(176, 186, 209, 0.4);
	}
	.search-fallback-btn {
		background: transparent;
		border: none;
		color: rgb(var(--gray-dark));
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 4px;
		transition: color 0.2s ease;
	}
	.search-fallback-btn:hover {
		color: var(--accent);
	}

	@media (max-width: 720px) {
		.search-fallback-form {
			margin: 0.5rem 0.5rem 1rem;
			padding: 0.5rem 0.8rem;
			display: flex;
			justify-content: space-between;
			width: auto;
		}
		.search-fallback-input {
			flex: 1;
			font-size: 0.95rem;
			width: auto;
		}
		.search-fallback-input:focus {
			width: auto;
		}
	}
</style>
