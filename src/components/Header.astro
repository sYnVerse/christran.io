---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav class="nav" aria-label="Main navigation">
		<h2><a href="/">{SITE_TITLE}</a></h2>

		<button
			type="button"
			class="hamburger"
			aria-label="Toggle menu"
			aria-expanded="false"
			aria-controls="nav-menu"
			id="hamburger-btn"
		>
			<span class="hamburger-box">
				<span class="hamburger-inner"></span>
			</span>
		</button>

		<div id="nav-menu" class="nav-menu" aria-hidden="true">
			<div class="internal-links">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/blog">Blog</HeaderLink>
				<HeaderLink href="/apps">Apps</HeaderLink>
				<HeaderLink href="/projects">Projects</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
			</div>
			<div class="social-links">
				<a href="https://linkedin.com/in/synchris" target="_blank">
					<span class="sr-only">Connect with me on LinkedIn</span>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32">
						<path
							fill="currentColor"
							d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
						></path>
					</svg>
				</a>
				<a href="https://github.com/sYnVerse" target="_blank">
					<span class="sr-only">Check out my GitHub</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32">
						<path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path>
					</svg>
				</a>
				<a href="/resume.pdf" target="_blank">
					<span class="sr-only">View my Resume</span>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32">
						<path
							fill="currentColor"
							d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm4 18H6V4h7v5h5v11zM8 15.5V17h8v-1.5H8zm0-3V14h8v-1.5H8z"
						></path>
					</svg>
				</a>
			</div>
		</div>
	</nav>
</header>

<script>
	const btn = document.getElementById('hamburger-btn');
	const menu = document.getElementById('nav-menu');
	if (btn && menu) {
		btn.addEventListener('click', () => {
			const isOpen = btn.getAttribute('aria-expanded') === 'true';
			btn.setAttribute('aria-expanded', String(!isOpen));
			menu.setAttribute('aria-hidden', String(isOpen));
			menu.classList.toggle('nav-menu--open');
			btn.classList.toggle('hamburger--active');
		});
		// Close menu when a nav link is clicked (for in-page anchors or SPA-like behavior)
		menu.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => {
				btn.setAttribute('aria-expanded', 'false');
				menu.setAttribute('aria-hidden', 'true');
				menu.classList.remove('nav-menu--open');
				btn.classList.remove('hamburger--active');
			});
		});
	}
</script>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--background);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: rgb(var(--black));
	}
	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--gray-dark));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
		color: var(--accent);
	}
	nav a:hover {
		color: var(--accent);
	}

	/* Hamburger: hidden on desktop */
	.hamburger {
		display: none;
		padding: 0.5em;
		margin: 0.25em 0;
		background: transparent;
		border: none;
		cursor: pointer;
		color: rgb(var(--gray-dark));
	}
	.hamburger:hover {
		color: var(--accent);
	}
	.hamburger-box {
		display: inline-block;
		width: 1.5em;
		height: 1em;
		position: relative;
	}
	.hamburger-inner {
		display: block;
		width: 100%;
		height: 3px;
		background: currentColor;
		border-radius: 2px;
		position: absolute;
		left: 0;
		top: 50%;
		transform: translateY(-50%);
		transition: transform 0.25s ease, opacity 0.2s ease;
	}
	.hamburger-inner::before,
	.hamburger-inner::after {
		content: '';
		display: block;
		width: 100%;
		height: 3px;
		background: currentColor;
		border-radius: 2px;
		position: absolute;
		left: 0;
		transition: transform 0.3s ease;
	}
	.hamburger-inner::before {
		top: -6px;
	}
	.hamburger-inner::after {
		top: 6px;
	}
	.hamburger--active .hamburger-inner {
		transform: translateY(-50%) rotate(225deg);
	}
	.hamburger--active .hamburger-inner::before {
		transform: translateY(6px) rotate(90deg);
	}
	.hamburger--active .hamburger-inner::after {
		transform: translateY(-6px) rotate(90deg);
	}

	/* Desktop: inline nav menu */
	.nav-menu {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.internal-links {
		display: flex;
		align-items: center;
	}
	.social-links,
	.social-links a {
		display: flex;
		align-items: center;
	}
	.social-links a {
		color: rgb(var(--gray-dark));
	}
	.social-links a:hover {
		color: var(--accent);
	}

	@media (max-width: 720px) {
		.hamburger {
			display: inline-flex;
			align-items: center;
			justify-content: center;
		}

		.nav-menu {
			display: grid;
			width: 100%;
			grid-template-rows: 0fr;
			overflow: hidden;
			transition: grid-template-rows 0.35s ease-out;
		}
		.nav-menu--open {
			grid-template-rows: 1fr;
		}
		.nav-menu > .internal-links,
		.nav-menu > .social-links {
			min-height: 0;
			overflow: hidden;
		}
		.internal-links {
			flex-direction: column;
			align-items: stretch;
			padding: 0.5em 0 1em;
			opacity: 0;
			transform: translateY(-8px);
			transition: opacity 0.3s ease 0.05s, transform 0.25s ease 0.05s;
		}
		.social-links {
			padding-bottom: 1em;
			gap: 0.5em;
			opacity: 0;
			transform: translateY(-8px);
			transition: opacity 0.3s ease 0.1s, transform 0.25s ease 0.1s;
		}
		.nav-menu--open .internal-links,
		.nav-menu--open .social-links {
			opacity: 1;
			transform: translateY(0);
		}
		.nav-menu a {
			padding: 0.6em 0.5em;
		}
	}
</style>
