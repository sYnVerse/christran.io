---
import type { Project } from '../data/projects';

interface Props {
	project: Project;
	compact?: boolean;
}

const { project, compact = false } = Astro.props;

const categoryLabels: Record<string, string> = {
	app: 'App',
	infrastructure: 'Infrastructure',
	community: 'Community',
};

const primaryUrl = project.liveUrl || project.detailUrl || '#';
---

<div class:list={['project-card', { compact }]} data-category={project.category}>
	<a href={primaryUrl} class="card-image-link" target={project.liveUrl ? '_blank' : undefined} rel={project.liveUrl ? 'noopener noreferrer' : undefined}>
		<div class="card-image">
			{project.image ? (
				<img src={project.image} alt={project.title} loading="lazy" width="600" height="340" />
			) : (
				<div class="card-image-placeholder">
					<span>{project.title[0]}</span>
				</div>
			)}
			<div class="card-image-overlay"></div>
			<span class="category-badge">{categoryLabels[project.category]}</span>
		</div>
	</a>

	<div class="card-body">
		<h3 class="card-title">{project.title}</h3>
		<p class="card-description">{project.description}</p>

		<div class="tech-stack">
			{project.techStack.map((tech) => (
				<span class="tech-pill">{tech}</span>
			))}
		</div>

		<div class="card-actions">
			{project.liveUrl && (
				<a href={project.liveUrl} class="action-btn action-primary" target="_blank" rel="noopener noreferrer">
					Visit Project
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
				</a>
			)}
			{project.detailUrl && (
				<a href={project.detailUrl} class="action-btn action-primary">
					View Details
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
				</a>
			)}
			{project.sourceUrl && (
				<a href={project.sourceUrl} class="action-btn action-secondary" target="_blank" rel="noopener noreferrer" aria-label={`View ${project.title} source on GitHub`}>
					<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
					Source
				</a>
			)}
		</div>
	</div>
</div>

<style>
	.project-card {
		display: flex;
		flex-direction: column;
		border-radius: 12px;
		background: rgba(30, 35, 50, 0.6);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid rgba(123, 158, 255, 0.1);
		border-top: 3px solid transparent;
		overflow: hidden;
		transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
	}

	.project-card:hover {
		transform: translateY(-6px);
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(123, 158, 255, 0.15);
		border-top-color: var(--accent);
	}

	.card-image-link {
		display: block;
		text-decoration: none;
		overflow: hidden;
	}

	.card-image {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}

	.compact .card-image {
		aspect-ratio: 16 / 8;
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		transition: transform 0.4s ease;
	}

	.project-card:hover .card-image img {
		transform: scale(1.05);
	}

	.card-image-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, rgba(123, 158, 255, 0.15), rgba(75, 110, 223, 0.25));
		font-size: 3rem;
		font-weight: 700;
		color: var(--accent);
	}

	.card-image-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(11, 16, 33, 0.6) 0%, transparent 50%);
		pointer-events: none;
	}

	.category-badge {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		padding: 0.2rem 0.6rem;
		background: rgba(11, 16, 33, 0.75);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border: 1px solid rgba(123, 158, 255, 0.2);
		border-radius: 20px;
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--accent);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.card-body {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: 1.25rem;
		gap: 0.75rem;
	}

	.compact .card-body {
		padding: 1rem;
	}

	.card-title {
		margin: 0;
		font-size: 1.2rem;
		color: rgb(var(--black));
		line-height: 1.3;
	}

	.card-description {
		margin: 0;
		font-size: 0.88rem;
		color: rgb(var(--gray));
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.tech-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.tech-pill {
		padding: 0.15rem 0.55rem;
		background: rgba(123, 158, 255, 0.12);
		border: 1px solid rgba(123, 158, 255, 0.2);
		border-radius: 4px;
		font-size: 0.72rem;
		font-weight: 500;
		color: var(--accent);
		letter-spacing: 0.02em;
	}

	.card-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem;
		margin-top: auto;
		padding-top: 0.5rem;
	}

	.action-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.45rem 0.9rem;
		border-radius: 6px;
		font-size: 0.82rem;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.action-primary {
		background: var(--accent);
		color: #0B1021;
	}

	.action-primary:hover {
		background: #9bb3ff;
		color: #0B1021;
		transform: translateY(-1px);
	}

	.action-secondary {
		background: rgba(123, 158, 255, 0.12);
		color: var(--accent);
		border: 1px solid rgba(123, 158, 255, 0.25);
	}

	.action-secondary:hover {
		background: rgba(123, 158, 255, 0.22);
		transform: translateY(-1px);
	}

	@media (max-width: 720px) {
		.card-body {
			padding: 1rem;
		}

		.card-title {
			font-size: 1.1rem;
		}

		.card-description {
			font-size: 0.85rem;
		}
	}

	@media (max-width: 480px) {
		.card-actions {
			flex-direction: column;
			align-items: stretch;
		}
		.action-btn {
			justify-content: center;
		}
	}
</style>
