---
// CodeBlock.astro
// Custom component to dynamically wrap and style code blocks on the personal website
---

<script>
  function setupCodeBlocks() {
    const codeBlocks = document.querySelectorAll('pre.astro-code');

    codeBlocks.forEach((pre) => {
      // Avoid double-wrapping if the script runs multiple times
      if (pre.closest('.code-block-wrapper')) return;

      const rawLanguage = pre.getAttribute('data-language');
      const language = rawLanguage || 'text';
      const cleanLang = language.toUpperCase();

      // Create wrapper element
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block-wrapper';

      // Insert wrapper into DOM just before the pre tag, then move pre inside
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      // Create header
      const header = document.createElement('div');
      header.className = 'code-block-header';
      header.innerHTML = `
        <div class="code-window-dots">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
        </div>
        <div class="code-header-right">
          <span class="code-lang">${cleanLang}</span>
          <button class="copy-code-btn" aria-label="Copy code">
            <svg class="copy-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <svg class="check-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#27C93F" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span class="copy-text">Copy</span>
          </button>
        </div>
      `;
      wrapper.insertBefore(header, pre);

      // Create scroll indicators
      const leftIndicator = document.createElement('div');
      leftIndicator.className = 'scroll-indicator scroll-indicator-left';
      const rightIndicator = document.createElement('div');
      rightIndicator.className = 'scroll-indicator scroll-indicator-right';
      
      wrapper.appendChild(leftIndicator);
      wrapper.appendChild(rightIndicator);

      // Check for line numbers eligibility
      const lines = pre.querySelectorAll('.line');
      const isPlaintext = !rawLanguage || ['plaintext', 'text', 'txt', 'none'].includes(rawLanguage.toLowerCase());
      if (lines.length >= 3 && !isPlaintext) {
        pre.classList.add('has-line-numbers');
      }

      // Handle horizontal scroll indicators
      const updateScrollIndicators = () => {
        const scrollLeft = pre.scrollLeft;
        const scrollWidth = pre.scrollWidth;
        const clientWidth = pre.clientWidth;

        // Tolerance of 2px for browser subpixel calculation discrepancies
        const hasScrollLeft = scrollLeft > 2;
        const hasScrollRight = scrollLeft < (scrollWidth - clientWidth - 2);

        if (hasScrollLeft) {
          leftIndicator.classList.add('visible');
        } else {
          leftIndicator.classList.remove('visible');
        }

        if (hasScrollRight) {
          rightIndicator.classList.add('visible');
        } else {
          rightIndicator.classList.remove('visible');
        }
      };

      // Set up scroll and resize event listeners
      pre.addEventListener('scroll', updateScrollIndicators);
      
      // Resize observer to handle container size changes
      const resizeObserver = new ResizeObserver(() => {
        updateScrollIndicators();
      });
      resizeObserver.observe(pre);

      // Copy to clipboard functionality
      const copyBtn = header.querySelector('.copy-code-btn');
      const copyText = header.querySelector('.copy-text');
      const copyIcon = header.querySelector('.copy-icon') as SVGElement;
      const checkIcon = header.querySelector('.check-icon') as SVGElement;

      if (copyBtn && copyText && copyIcon && checkIcon) {
        copyBtn.addEventListener('click', async () => {
          // Extract text, keeping newlines intact
          let codeText = '';
          const lineElems = pre.querySelectorAll('.line');
          if (lineElems.length > 0) {
            codeText = Array.from(lineElems).map(el => (el as HTMLElement).innerText).join('\n');
          } else {
            codeText = pre.innerText;
          }

          try {
            await navigator.clipboard.writeText(codeText);
            
            // Success visual feedback
            copyBtn.classList.add('copied');
            copyText.textContent = 'Copied!';
            copyIcon.style.display = 'none';
            checkIcon.style.display = 'inline-block';

            setTimeout(() => {
              copyBtn.classList.remove('copied');
              copyText.textContent = 'Copy';
              copyIcon.style.display = 'inline-block';
              checkIcon.style.display = 'none';
            }, 2000);
          } catch (err) {
            console.error('Failed to copy text: ', err);
            copyText.textContent = 'Error';
          }
        });
      }

      // Initial check
      setTimeout(updateScrollIndicators, 100);
    });
  }

  // Run on page load
  document.addEventListener('DOMContentLoaded', setupCodeBlocks);
  // Run on view transition/navigation (support Astro view transitions if used)
  document.addEventListener('astro:page-load', setupCodeBlocks);
  // Fail-safe execution
  setupCodeBlocks();
</script>

<style is:global>
  /* Premium Code Block Wrapper */
  .code-block-wrapper {
    position: relative;
    margin: 2rem 0;
    border-radius: 12px;
    background: rgba(15, 20, 35, 0.45);
    border: 1px solid rgba(123, 158, 255, 0.15);
    box-shadow: 
      0 4px 6px -1px rgba(0, 0, 0, 0.2), 
      0 10px 30px -3px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    overflow: hidden;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .code-block-wrapper:hover {
    border-color: rgba(123, 158, 255, 0.3);
    box-shadow: 
      0 4px 20px -2px rgba(123, 158, 255, 0.1), 
      0 12px 35px -3px rgba(0, 0, 0, 0.5);
  }

  /* Header Bar */
  .code-block-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1.25rem;
    background: rgba(10, 12, 22, 0.7);
    border-bottom: 1px solid rgba(123, 158, 255, 0.1);
    user-select: none;
  }

  /* macOS Window Controls */
  .code-window-dots {
    display: flex;
    gap: 7px;
  }

  .code-window-dots .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  .code-window-dots .dot.red { background-color: #FF5F56; }
  .code-window-dots .dot.yellow { background-color: #FFBD2E; }
  .code-window-dots .dot.green { background-color: #27C93F; }

  /* Header Controls Right */
  .code-header-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  /* Language Label */
  .code-lang {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(176, 186, 209, 0.5);
    letter-spacing: 0.08em;
  }

  /* Copy Button */
  .copy-code-btn {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: transparent;
    border: 1px solid rgba(123, 158, 255, 0.2);
    border-radius: 6px;
    padding: 0.25rem 0.55rem;
    color: rgba(176, 186, 209, 0.75);
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .copy-code-btn:hover {
    color: var(--accent);
    background: rgba(123, 158, 255, 0.08);
    border-color: rgba(123, 158, 255, 0.45);
  }

  .copy-code-btn.copied {
    border-color: rgba(39, 201, 63, 0.4);
    background: rgba(39, 201, 63, 0.08);
    color: #27C93F;
  }

  /* Scroll indicators */
  .scroll-indicator {
    position: absolute;
    top: 36px; /* below header */
    bottom: 0;
    width: 35px;
    pointer-events: none;
    transition: opacity 0.3s ease;
    opacity: 0;
    z-index: 10;
  }

  .scroll-indicator-left {
    left: 0;
    background: linear-gradient(to left, rgba(15, 20, 35, 0) 0%, rgba(11, 16, 33, 0.6) 100%);
  }

  .scroll-indicator-right {
    right: 0;
    background: linear-gradient(to right, rgba(15, 20, 35, 0) 0%, rgba(11, 16, 33, 0.6) 100%);
  }

  .scroll-indicator.visible {
    opacity: 1;
  }

  /* Astro pre code styling overrides */
  pre.astro-code {
    margin: 0 !important;
    padding: 1.25rem 1.5rem !important;
    background-color: transparent !important; /* Let glassmorphic wrapper background display */
    overflow-x: auto !important;
    font-size: 0.92rem;
    line-height: 1.6;
    outline: none;
  }

  pre.astro-code code {
    display: grid;
    min-width: max-content;
  }

  pre.astro-code .line {
    display: block;
    position: relative;
    transition: background-color 0.15s ease;
    min-height: 1.6em;
  }

  pre.astro-code .line:hover {
    background-color: rgba(123, 158, 255, 0.05);
  }

  /* Scrollbars styling */
  pre.astro-code::-webkit-scrollbar {
    height: 7px;
  }

  pre.astro-code::-webkit-scrollbar-track {
    background: transparent;
  }

  pre.astro-code::-webkit-scrollbar-thumb {
    background: rgba(123, 158, 255, 0.15);
    border-radius: 4px;
  }

  pre.astro-code::-webkit-scrollbar-thumb:hover {
    background: rgba(123, 158, 255, 0.35);
  }

  /* Line numbers styling */
  pre.astro-code.has-line-numbers {
    counter-reset: step;
    padding-left: 1rem !important;
  }

  pre.astro-code.has-line-numbers .line {
    padding-left: 3rem;
  }

  pre.astro-code.has-line-numbers .line::before {
    counter-increment: step;
    content: counter(step);
    position: absolute;
    left: 0.5rem;
    width: 1.8rem;
    text-align: right;
    color: rgba(176, 186, 209, 0.3);
    user-select: none;
    font-size: 0.82rem;
    font-weight: 500;
  }

  /* Mobile Responsive Tweaks */
  @media (max-width: 720px) {
    .code-block-wrapper {
      margin: 1.5rem 0;
      border-radius: 8px;
    }
    
    .code-block-header {
      padding: 0.5rem 1rem;
    }
    
    pre.astro-code {
      padding: 1rem 1.15rem !important;
      font-size: 0.85rem;
      line-height: 1.55;
    }

    pre.astro-code.has-line-numbers {
      padding-left: 0.65rem !important;
    }

    pre.astro-code.has-line-numbers .line {
      padding-left: 2.3rem;
    }

    pre.astro-code.has-line-numbers .line::before {
      left: 0.1rem;
      width: 1.5rem;
      font-size: 0.75rem;
    }

    .code-header-right {
      gap: 0.75rem;
    }

    .copy-code-btn {
      padding: 0.2rem 0.4rem;
    }

    .copy-text {
      display: none; /* Hide 'Copy' text on mobile screens to save space */
    }
  }
</style>
