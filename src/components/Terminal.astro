				function appendLine(html) {
					const line = document.createElement('div');
					line.className = 'term-line';
					line.innerHTML = html;
					output.appendChild(line);
					
					try {
						sessionStorage.setItem('term_output', output.innerHTML);
					} catch (e) {}
					
					const body = output.parentElement;
					if (body) {
						body.scrollTop = body.scrollHeight;
					}
				}

				function escapeHtml(s) {
					const div = document.createElement('div');
					div.textContent = s;
					return div.innerHTML;
				}

				function escapeHtmlWithBreaks(s) {
					return s.split('\n').map(escapeHtml).join('<br>');
				}

				function runCommand(cmd) {
					return new Promise((resolve) => {
						const trimmed = cmd.trim();
						if (trimmed === '') {
							resolve();
							return;
						}

						// Print the prompt and entered command immediately
						appendLine('<span class="term-prompt">' + promptText + '</span>' + escapeHtml(cmd));

						// Parse command and arguments
						const parts = trimmed.split(/\s+/);
						const baseCmd = parts[0].toLowerCase();
						const cmdArgs = parts.slice(1).join(' ');

						// Determine canonical command name (with alias support)
						let canonical = baseCmd;
						if (baseCmd === 'tr' || baseCmd === 'tracert') {
							canonical = 'traceroute';
						} else if (baseCmd === 'certifications') {
							canonical = 'certs';
						}

						// Let's match the exact key first (for multi-word static commands like 'ping skills')
						const fullLower = trimmed.toLowerCase();
						let resolvedCmdKey = '';
						
						if (commands[fullLower] !== undefined) {
							resolvedCmdKey = fullLower;
						} else if (commands[canonical] !== undefined) {
							resolvedCmdKey = canonical;
						}

						if (resolvedCmdKey === '') {
							// Custom alias checking for special cases
							if (fullLower === 'tr' || fullLower === 'tracert' || fullLower === 'tracert career') {
								resolvedCmdKey = 'traceroute career';
							} else if (fullLower === 'ping') {
								resolvedCmdKey = 'ping skills';
							} else if (baseCmd === 'search') {
								resolvedCmdKey = 'search';
							} else {
								TerminalSound.playError();
								appendLine('<span class="term-response">bash: ' + escapeHtml(baseCmd) + ': command not found. Try `help`</span>');
								resolve();
								return;
							}
						}

						const response = commands[resolvedCmdKey];
						const result = typeof response === 'function' ? response(cmdArgs) : response;

						if (result === undefined) {
							resolve();
							return;
						}

						if (result instanceof Promise) {
							isCommandRunning = true;
							result.then((resolvedResult) => {
								handleCommandResult(resolvedCmdKey, resolvedResult);
								isCommandRunning = false;
								resolve();
							}).catch((err) => {
								appendLine('<span class="term-response" style="color: #ff5f56;">Error running command.</span>');
								isCommandRunning = false;
								resolve();
							});
						} else if (result && result.type === 'async') {
							if (result.lines.length > 0) {
								animateOutputLines(result.lines, result.delay, 0, () => {
									resolve();
								});
							} else {
								resolve();
							}
						} else {
							handleCommandResult(resolvedCmdKey, result);
							resolve();
						}
					});
				}

				function handleCommandResult(cmdKey, result) {
					if (result === '__CLEAR__') {
						output.innerHTML = '';
						try {
							sessionStorage.removeItem('term_output');
						} catch (e) {}
						return;
					}
					if (String(result).indexOf('__HTML__') === 0) {
						appendLine('<span class="term-response">' + result.slice(7) + '</span>');
						return;
					}
					if (cmdKey === 'traceroute career') {
						const tracerouteHtml = 'traceroute to career (192.168.1.1), 30 hops max<br> 1  <a href="https://foothill.edu" target="_blank" rel="noopener noreferrer">foothill.edu</a> (1.2 ms)<br> 2  <a href="https://ucsd.edu" target="_blank" rel="noopener noreferrer">ucsd.edu</a> (4.8 ms)<br> 3  <a href="https://amazon.com" target="_blank" rel="noopener noreferrer">amazon.com</a> (8.4 ms)<br> 4  <a href="https://santaclaracounty.gov" target="_blank" rel="noopener noreferrer">santaclaracounty.gov</a> (12.1 ms)<br> 5  <a href="https://microsoft.com" target="_blank" rel="noopener noreferrer">microsoft.com</a> (18.7 ms)<br> 6  <a href="https://www.autochlor.com" target="_blank" rel="noopener noreferrer">autochlor.com</a> (22.3 ms)<br> 7  <a href="https://wgu.edu" target="_blank" rel="noopener noreferrer">wgu.edu</a> (28.9 ms)<br><br>Destination reached. Next hop: whatever I\'m building next!';
						appendLine('<span class="term-response">' + tracerouteHtml + '</span>');
						return;
					}
					appendLine('<span class="term-response">' + escapeHtmlWithBreaks(result) + '</span>');
				}

				let history = [];
				try {
					const savedHistory = sessionStorage.getItem('term_history');
					if (savedHistory) {
						history = JSON.parse(savedHistory);
					}
				} catch (e) {}
				let historyIndex = -1;

				function handleTabComplete() {
					const val = input.value;
					const trimmed = val.toLowerCase();
					
					// Filter matching candidates
					const matches = autocompleteCandidates.filter(function (c) {
						return c.indexOf(trimmed) === 0;
					});
					
					if (matches.length === 0) {
						return; // No matches
					}
					
					if (matches.length === 1) {
						input.value = matches[0];
						updateInputText();
						if (ghostText) {
							ghostText.textContent = '';
						}
					} else {
						// Find longest common prefix
						let longestPrefix = matches[0];
						for (let i = 1; i < matches.length; i++) {
							let j = 0;
							while (j < longestPrefix.length && j < matches[i].length && longestPrefix[j] === matches[i][j]) {
								j++;
							}
							longestPrefix = longestPrefix.slice(0, j);
						}
						
						if (longestPrefix.length > trimmed.length) {
							input.value = longestPrefix;
							updateInputText();
						} else {
							// Print matches
							appendLine('<span class="term-prompt">' + promptText + '</span>' + escapeHtml(val));
							appendLine('<span class="term-response">' + matches.join('    ') + '</span>');
						}
					}
				}

				// Exit matrix rain on any keypress
				document.addEventListener('keydown', function (e) {
					if (matrixInterval) {
						e.preventDefault();
						abortActiveCommand();
					}
				});

				input.addEventListener('keydown', function (e) {
					// Block input actions during running async command
					if (isCommandRunning && e.key !== 'c' && !e.ctrlKey) {
						e.preventDefault();
						return;
					}

					if (e.ctrlKey && e.key.toLowerCase() === 'l') {
						e.preventDefault();
						runCommand('clear');
					} else if (e.ctrlKey && e.key.toLowerCase() === 'c') {
						e.preventDefault();
						abortActiveCommand();
					} else if (e.key === 'Tab') {
						e.preventDefault();
						if (ghostText && ghostText.textContent) {
							acceptAutocomplete();
						} else {
							handleTabComplete();
						}
					} else if (e.key === 'ArrowRight' && input.selectionStart === input.value.length) {
						if (ghostText && ghostText.textContent) {
							e.preventDefault();
							acceptAutocomplete();
						}
					} else if (e.key === 'ArrowUp') {
						e.preventDefault();
						if (history.length > 0) {
							if (historyIndex === -1) {
								historyIndex = history.length - 1;
							} else if (historyIndex > 0) {
								historyIndex--;
							}
							input.value = history[historyIndex];
							updateInputText();
							if (ghostText) {
								ghostText.textContent = '';
							}
							setTimeout(function () {
								input.selectionStart = input.selectionEnd = input.value.length;
							}, 0);
						}
					} else if (e.key === 'ArrowDown') {
						e.preventDefault();
						if (history.length > 0 && historyIndex !== -1) {
							if (historyIndex < history.length - 1) {
								historyIndex++;
								input.value = history[historyIndex];
							} else {
								historyIndex = -1;
								input.value = '';
							}
							updateInputText();
							if (ghostText) {
								ghostText.textContent = '';
							}
							setTimeout(function () {
								input.selectionStart = input.selectionEnd = input.value.length;
							}, 0);
						}
					} else if (e.key === 'Enter') {
						e.preventDefault();
						e.stopPropagation();
						var cmd = input.value;
						input.value = '';
						updateInputText();
						if (ghostText) {
							ghostText.textContent = '';
						}
						
						if (cmd.trim() !== '') {
							if (history.length === 0 || history[history.length - 1] !== cmd) {
								history.push(cmd);
								try {
									sessionStorage.setItem('term_history', JSON.stringify(history));
								} catch (e) {}
							}
							historyIndex = -1;
						}
						
						runCommand(cmd);
					}
				});

				// Dragging window helper
				function makeDraggable(winWidget, winTitlebar) {
					let pos1 = 0, pos2 = 0, pos3 = 0, pos4 = 0;
					
					winTitlebar.addEventListener('mousedown', dragMouseDown);
					winTitlebar.addEventListener('touchstart', dragTouchStart, { passive: false });

					function dragMouseDown(e) {
						if (winWidget.classList.contains('maximized')) return;
						e.preventDefault();
						pos3 = e.clientX;
						pos4 = e.clientY;
						document.addEventListener('mouseup', closeDragElement);
						document.addEventListener('mousemove', elementDrag);
					}

					function dragTouchStart(e) {
						if (winWidget.classList.contains('maximized')) return;
						pos3 = e.touches[0].clientX;
						pos4 = e.touches[0].clientY;
						document.addEventListener('touchend', closeDragElement);
						document.addEventListener('touchmove', elementTouchDrag, { passive: false });
					}

					function elementDrag(e) {
						e.preventDefault();
						pos1 = pos3 - e.clientX;
						pos2 = pos4 - e.clientY;
						pos3 = e.clientX;
						pos4 = e.clientY;
						
						let newTop = winWidget.offsetTop - pos2;
						let newLeft = winWidget.offsetLeft - pos1;
						
						const maxLeft = window.innerWidth - winWidget.clientWidth;
						const maxTop = window.innerHeight - winWidget.clientHeight;
						
						newLeft = Math.max(0, Math.min(newLeft, maxLeft));
						newTop = Math.max(0, Math.min(newTop, maxTop));

						winWidget.style.top = newTop + "px";
						winWidget.style.left = newLeft + "px";
						winWidget.style.bottom = "auto";
						winWidget.style.right = "auto";
					}

					function elementTouchDrag(e) {
						e.preventDefault();
						pos1 = pos3 - e.touches[0].clientX;
						pos2 = pos4 - e.touches[0].clientY;
						pos3 = e.touches[0].clientX;
						pos4 = e.touches[0].clientY;
						
						let newTop = winWidget.offsetTop - pos2;
						let newLeft = winWidget.offsetLeft - pos1;
						
						const maxLeft = window.innerWidth - winWidget.clientWidth;
						const maxTop = window.innerHeight - winWidget.clientHeight;
						
						newLeft = Math.max(0, Math.min(newLeft, maxLeft));
						newTop = Math.max(0, Math.min(newTop, maxTop));

						winWidget.style.top = newTop + "px";
						winWidget.style.left = newLeft + "px";
						winWidget.style.bottom = "auto";
						winWidget.style.right = "auto";
					}

					function closeDragElement() {
						document.removeEventListener('mouseup', closeDragElement);
						document.removeEventListener('mousemove', elementDrag);
						document.removeEventListener('touchend', closeDragElement);
						document.removeEventListener('touchmove', elementTouchDrag);
					}
				}

				// Terminal widget trigger & close logic
				const trigger = document.getElementById('terminal-trigger');
				const widget = document.getElementById('terminal-widget');
				const dotClose = document.getElementById('terminal-dot-close');
				const dotMinimize = document.getElementById('terminal-dot-minimize');
				const dotMaximize = document.getElementById('terminal-dot-maximize');
				const titlebar = document.getElementById('terminal-titlebar');
				const triggerIcon = trigger ? trigger.querySelector('.trigger-icon-svg') : null;
				const closeIcon = trigger ? trigger.querySelector('.close-icon-svg') : null;

				if (widget && titlebar) {
					makeDraggable(widget, titlebar);
				}

				function toggleTerminal() {
					if (!widget || !trigger) return;
					const isOpen = widget.classList.toggle('open');
					if (isOpen && widget.classList.contains('minimized')) {
						widget.classList.remove('minimized');
					}
					trigger.setAttribute('aria-expanded', String(isOpen));
					try {
						sessionStorage.setItem('term_open', String(isOpen));
						if (isOpen) {
							sessionStorage.setItem('term_open_path', window.location.pathname);
							TerminalSound.playStartup();
						} else {
							sessionStorage.removeItem('term_open_path');
						}
					} catch (e) {}
					if (isOpen) {
						if (triggerIcon) triggerIcon.style.display = 'none';
						if (closeIcon) closeIcon.style.display = 'block';
						if (window.innerWidth > 640) {
							input.focus();
						} else {
							setTimeout(function () {
								input.focus();
							}, 150);
						}
					} else {
						if (triggerIcon) triggerIcon.style.display = 'block';
						if (closeIcon) closeIcon.style.display = 'none';
						input.blur();
						abortActiveCommand();
					}
				}

				if (trigger) {
					trigger.addEventListener('click', toggleTerminal);
				}

				// Minimize button action
				if (dotMinimize) {
					dotMinimize.addEventListener('click', function (e) {
						e.stopPropagation();
						
						// If maximized, restore normal size first
						if (widget.classList.contains('maximized')) {
							widget.classList.remove('maximized');
							widget.style.top = widget.dataset.prevTop || '';
							widget.style.left = widget.dataset.prevLeft || '';
							widget.style.right = widget.dataset.prevRight || '';
							widget.style.bottom = widget.dataset.prevBottom || '';
						}
						
						widget.classList.toggle('minimized');
						if (!widget.classList.contains('minimized')) {
							input.focus();
						}
					});
				}

				// Maximize button action
				if (dotMaximize) {
					dotMaximize.addEventListener('click', function (e) {
						e.stopPropagation();
						
						// If minimized, restore it first
						if (widget.classList.contains('minimized')) {
							widget.classList.remove('minimized');
						}
						
						widget.classList.toggle('maximized');
						if (widget.classList.contains('maximized')) {
							widget.dataset.prevTop = widget.style.top;
							widget.dataset.prevLeft = widget.style.left;
							widget.dataset.prevRight = widget.style.right;
							widget.dataset.prevBottom = widget.style.bottom;
							widget.style.top = '';
							widget.style.left = '';
							widget.style.right = '';
							widget.style.bottom = '';
						} else {
							widget.style.top = widget.dataset.prevTop || '';
							widget.style.left = widget.dataset.prevLeft || '';
							widget.style.right = widget.dataset.prevRight || '';
							widget.style.bottom = widget.dataset.prevBottom || '';
						}
						input.focus();
					});
				}

				// Restore terminal open state on page load
				try {
					const isOpen = sessionStorage.getItem('term_open') === 'true';
					const openPath = sessionStorage.getItem('term_open_path');
					if (isOpen && openPath === window.location.pathname) {
						widget.classList.add('open');
						trigger.setAttribute('aria-expanded', 'true');
						if (triggerIcon) triggerIcon.style.display = 'none';
						if (closeIcon) closeIcon.style.display = 'block';
						const body = output.parentElement;
						if (body) {
							body.scrollTop = body.scrollHeight;
						}
					} else if (isOpen) {
						sessionStorage.setItem('term_open', 'false');
						sessionStorage.removeItem('term_open_path');
					}
				} catch (e) {}

				// Restore CRT mode on page load
				try {
					const crtSaved = localStorage.getItem('term_crt');
					if (crtSaved === 'true') {
						widget.classList.add('crt-mode');
					} else if (crtSaved === 'false') {
						widget.classList.remove('crt-mode');
					} else {
						widget.classList.add('crt-mode'); // default CRT to on
					}
				} catch (e) {}

				if (dotClose) {
					dotClose.addEventListener('click', function (e) {
						e.stopPropagation();
						toggleTerminal();
					});
				}

				// Click outside to close (desktop only)
				document.addEventListener('click', function (event) {
					if (!widget || !trigger) return;
					if (widget.classList.contains('open') && 
						!widget.contains(event.target) && 
						!trigger.contains(event.target)) {
						toggleTerminal();
					}
				});

				// Normalize position on window resize if window bounds shrink
				window.addEventListener('resize', function () {
					if (widget && !widget.classList.contains('maximized')) {
						const rect = widget.getBoundingClientRect();
						if (rect.right > window.innerWidth || rect.bottom > window.innerHeight) {
							widget.style.top = '';
							widget.style.left = '';
							widget.style.bottom = '';
							widget.style.right = '';
						}
					}
				});

				// WebMCP Tool Registration for Retro Terminal Widget
				const modelContext = document.modelContext || (typeof navigator !== 'undefined' && navigator.modelContext);
				if (modelContext && typeof modelContext.registerTool === 'function') {
					if (window.terminalToolController) {
						window.terminalToolController.abort();
					}
					const controller = new AbortController();
					window.terminalToolController = controller;

					modelContext.registerTool({
						name: 'run_terminal_command',
						description: 'Execute a command in the interactive retro terminal widget and return the console output.',
						inputSchema: {
							type: 'object',
							properties: {
								command: {
									type: 'string',
									description: 'The command to execute in the terminal (e.g. `help`, `about`, `skills`, `projects`, `clear`, `contact`, `theme`, `sound`, `matrix`, `neofetch`, `traceroute career`)'
								}
							},
							required: ['command']
						},
						execute: async ({ command }) => {
							const isTerminalOpen = widget && widget.classList.contains('open');
							if (!isTerminalOpen) {
								toggleTerminal();
							}
							if (widget && widget.classList.contains('minimized')) {
								widget.classList.remove('minimized');
							}
							const previousLinesCount = output.children.length;
							
							// Put command in history so the retro terminal behaves naturally
							if (command.trim() !== '') {
								if (history.length === 0 || history[history.length - 1] !== command) {
									history.push(command);
									try {
										sessionStorage.setItem('term_history', JSON.stringify(history));
									} catch (e) {}
								}
								historyIndex = -1;
							}
							
							await runCommand(command);
							
							const currentLines = Array.from(output.children);
							const newLines = currentLines.length < previousLinesCount ? currentLines : currentLines.slice(previousLinesCount);
							return newLines.map(line => line.textContent || '').join('\n');
						}
					}, { signal: controller.signal });
				}

			});
		</script>
