				// Theme and CRT Management helper functions
				function setTheme(themeName) {
					if (terminalWindow) {
						terminalWindow.setAttribute('data-theme', themeName);
						try {
							localStorage.setItem('term_theme', themeName);
						} catch (e) {}
					}
				}

				// Restore theme
				try {
					const savedTheme = localStorage.getItem('term_theme');
					if (savedTheme) {
						setTheme(savedTheme);
					}
				} catch (e) {}

				// Restore terminal output from sessionStorage if exists
				try {
					const savedOutput = sessionStorage.getItem('term_output');
					if (savedOutput) {
						output.innerHTML = savedOutput;
						const body = output.parentElement;
						if (body) {
							body.scrollTop = body.scrollHeight;
						}
					}
				} catch (e) {}

				// Click-to-focus terminal
				if (terminalWindow) {
					terminalWindow.addEventListener('click', function () {
						if (matrixInterval) {
							abortActiveCommand();
						} else {
							input.focus();
						}
					});
				}

				const inputVal = document.getElementById('term-input-val');
				function updateInputText() {
					if (inputVal) {
						inputVal.textContent = input.value;
					}
				}
				updateInputText();

				function updateGhostText() {
					if (!ghostText) return;
					const currentVal = input.value;
					const normalizedVal = currentVal.trim().toLowerCase();

					if (!normalizedVal) {
						ghostText.textContent = '';
						return;
					}

					const match = autocompleteCandidates.find(function (cmd) {
						return cmd.indexOf(normalizedVal) === 0;
					});

					if (match) {
						const remainder = match.slice(normalizedVal.length);
						ghostText.textContent = currentVal + remainder;
					} else {
						ghostText.textContent = '';
					}
				}

				function acceptAutocomplete() {
					if (ghostText && ghostText.textContent) {
						input.value = ghostText.textContent;
						ghostText.textContent = '';
						updateInputText();
					}
				}

				input.addEventListener('input', function () {
					updateInputText();
					updateGhostText();
					TerminalSound.playClick();
				});

				// Mobile swipe-to-complete coordinates
				let touchStartX = 0;
				let touchStartY = 0;

				input.addEventListener('touchstart', function (e) {
					touchStartX = e.changedTouches[0].screenX;
					touchStartY = e.changedTouches[0].screenY;
				}, { passive: true });

				input.addEventListener('touchend', function (e) {
					const touchEndX = e.changedTouches[0].screenX;
					const touchEndY = e.changedTouches[0].screenY;
					
					const diffX = touchEndX - touchStartX;
					const diffY = touchEndY - touchStartY;

					// Ensure horizontal swipe is dominant and goes right (min 40px)
					if (Math.abs(diffX) > Math.abs(diffY) && diffX > 40) {
						acceptAutocomplete();
					}
				});

				if (ghostText) {
					ghostText.addEventListener('click', function () {
						acceptAutocomplete();
						input.focus();
					});
				}

				const promptText = 'visitor@christran.io:~$';

				// Asynchronous commands logic
				let activeAnimationTimeout = null;
				let isCommandRunning = false;

				function animateOutputLines(lines, delay, index = 0, onComplete) {
					if (index >= lines.length) {
						isCommandRunning = false;
						if (onComplete) onComplete();
						input.focus();
						return;
					}

					isCommandRunning = true;
					const line = lines[index];
					if (line.indexOf('__HTML__') === 0) {
						appendLine('<span class="term-response">' + line.slice(7) + '</span>');
					} else {
						appendLine('<span class="term-response">' + escapeHtmlWithBreaks(line) + '</span>');
					}

					activeAnimationTimeout = setTimeout(function () {
						animateOutputLines(lines, delay, index + 1, onComplete);
					}, delay);
				}

				function abortActiveCommand() {
					if (activeAnimationTimeout) {
						clearTimeout(activeAnimationTimeout);
						activeAnimationTimeout = null;
					}
					if (isCommandRunning) {
						appendLine('<span class="term-response" style="color: #ff5f56;">^C (aborted)</span>');
						isCommandRunning = false;
					}
					stopMatrixRain();
					input.focus();
				}

				// Matrix Canvas Rain Animation
				let matrixInterval = null;
				function startMatrixRain() {
					const canvas = document.getElementById('terminal-matrix-canvas');
					if (!canvas) return;

					const body = canvas.parentElement;
					if (body) {
						body.scrollTop = 0;
						body.style.overflowY = 'hidden';
					}

					canvas.style.display = 'block';
					
					// Set sizes
					const width = body.clientWidth;
					const height = body.clientHeight;
					canvas.width = width;
					canvas.height = height;

					const ctx = canvas.getContext('2d');
					const fontSize = 14;
					const columns = Math.floor(width / fontSize);
					const drops = [];

					for (let i = 0; i < columns; i++) {
						drops[i] = Math.random() * -100;
					}

					const chars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄ";

					function draw() {
						ctx.fillStyle = 'rgba(0, 0, 0, 0.06)';
						ctx.fillRect(0, 0, width, height);

						ctx.fillStyle = '#39ff14';
						ctx.font = fontSize + 'px monospace';

						for (let i = 0; i < drops.length; i++) {
							const char = chars[Math.floor(Math.random() * chars.length)];
							ctx.fillText(char, i * fontSize, drops[i] * fontSize);

							if (drops[i] * fontSize > height && Math.random() > 0.975) {
								drops[i] = 0;
							}
							drops[i]++;
						}
					}

					if (output) output.style.display = 'none';
					const inputLine = document.querySelector('.terminal-input-line');
					if (inputLine) inputLine.style.display = 'none';

					matrixInterval = setInterval(draw, 33);
				}

				function stopMatrixRain() {
					if (!matrixInterval) return;
					clearInterval(matrixInterval);
					matrixInterval = null;

					const canvas = document.getElementById('terminal-matrix-canvas');
					if (canvas) {
						canvas.style.display = 'none';
					}

					const body = document.getElementById('terminal-body');
					if (body) {
						body.style.overflowY = '';
						body.scrollTop = body.scrollHeight;
					}

					if (output) output.style.display = 'block';
					const inputLine = document.querySelector('.terminal-input-line');
					if (inputLine) inputLine.style.display = 'flex';
				}

