---
---
<button id="terminal-trigger" class="terminal-trigger-btn" aria-label="Open interactive terminal" aria-expanded="false" aria-controls="terminal-widget">
			<span class="terminal-trigger-face">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="trigger-icon-svg"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="close-icon-svg" style="display: none;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
			</span>
		</button>
		<noscript>
			<style>
				#terminal-trigger, .terminal-trigger-btn {
					display: none !important;
				}
			</style>
		</noscript>

		<section class="terminal-widget" id="terminal-widget" aria-label="Interactive terminal widget">
			<div class="terminal-window" id="terminal-window">
				<div class="terminal-crt-overlay"></div>
				<div class="terminal-titlebar" id="terminal-titlebar">
					<div class="terminal-dots">
						<span class="dot red" id="terminal-dot-close" title="Close" role="button" aria-label="Close terminal"></span>
						<span class="dot yellow" id="terminal-dot-minimize" title="Minimize/Restore" role="button" aria-label="Minimize terminal"></span>
						<span class="dot green" id="terminal-dot-maximize" title="Maximize/Restore" role="button" aria-label="Maximize terminal"></span>
					</div>
					<span class="terminal-title">visitor@christran.io — bash</span>
				</div>
				<div class="terminal-body" id="terminal-body">
					<canvas id="terminal-matrix-canvas" style="display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 5; pointer-events: none;"></canvas>
					<div class="terminal-output" id="term-output" role="log">
						<div class="term-line">
							<span class="term-prompt">visitor@christran.io:~$</span>type a command and press Enter. try <code>help</code> or <code>ls</code>
						</div>
					</div>
					<div class="terminal-input-line">
						<span class="term-prompt term-prompt-full">visitor@christran.io:~$</span>
						<span class="term-prompt term-prompt-short" aria-hidden="true">$ </span>
						<span class="terminal-input-wrap">
							<span class="terminal-input-val" id="term-input-val" aria-hidden="true"></span>
							<span class="term-cursor" aria-hidden="true"></span>
							<span class="ghost-text" id="ghost-text" aria-hidden="true"></span>
							<input
								type="text"
								class="terminal-input"
								id="term-input"
								autocomplete="off"
								autocapitalize="off"
								spellcheck="false"
								aria-label="Terminal command input"
							/>
						</span>
					</div>
				</div>
			</div>
		</section>

<style>
			.terminal-trigger-btn {
				position: fixed;
				bottom: 2rem;
				right: 2rem;
				width: 56px;
				height: 56px;
				border-radius: 50%;
				border: none;
				background: none;
				padding: 0;
				cursor: pointer;
				z-index: 1001;
				overflow: visible;
				transition: transform 0.22s cubic-bezier(0.34, 1.45, 0.64, 1), filter 0.2s ease;
			}
			.terminal-trigger-btn:hover:not([aria-expanded="true"]) {
				transform: scale(1.07);
			}
			.terminal-trigger-btn:active:not([aria-expanded="true"]) {
				transform: scale(0.98);
			}
			.terminal-trigger-btn::before,
			.terminal-trigger-btn::after {
				content: "";
				position: absolute;
				left: -2px;
				top: -2px;
				width: calc(100% + 4px);
				height: calc(100% + 4px);
				border-radius: 50%;
				z-index: 0;
				transition: opacity 0.32s ease;
				background: linear-gradient(45deg, #042f4a, #0a4d6e, #0d6b7d, #0e7490, #0891b2, #06b6d4, #22d3ee, #2dd4bf, #34d399, #5eead4, #67e8f9, #38bdf8, #0ea5e9, #0369a1, #042f4a);
				background-size: 400%;
				animation: terminal-gradient-flow 10s linear infinite;
				pointer-events: none;
			}
			.terminal-trigger-btn::after {
				filter: blur(30px);
				opacity: 0.75;
				transition: filter 0.32s ease, opacity 0.32s ease;
			}
			.terminal-trigger-btn:hover:not([aria-expanded="true"])::after {
				filter: blur(40px) brightness(1.3);
				opacity: 1;
			}
			.terminal-trigger-btn[aria-expanded="true"]::before,
			.terminal-trigger-btn[aria-expanded="true"]::after {
				opacity: 0;
				animation: none;
			}
			.terminal-trigger-face {
				position: relative;
				z-index: 1;
				display: flex;
				width: 100%;
				height: 100%;
				justify-content: center;
				align-items: center;
				border-radius: 50%;
				background: linear-gradient(135deg, rgba(30, 35, 50, 0.95) 0%, rgba(15, 20, 35, 0.98) 100%);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				border: 1px solid rgba(123, 158, 255, 0.3);
				color: var(--accent);
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 8px 32px rgba(0, 0, 0, 0.5);
				transition: all 0.22s ease;
			}
			.terminal-trigger-btn:hover:not([aria-expanded="true"]) .terminal-trigger-face {
				color: #ffffff;
				background: linear-gradient(135deg, rgba(40, 48, 75, 0.95) 0%, rgba(20, 27, 50, 0.98) 100%);
				border-color: rgba(123, 158, 255, 0.6);
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), 0 12px 40px rgba(0, 0, 0, 0.6);
			}
			.terminal-trigger-btn[aria-expanded="true"] .terminal-trigger-face {
				background: #252836;
				border-color: rgba(255, 95, 86, 0.4);
				color: #ff5f56;
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 4px 12px rgba(0, 0, 0, 0.3);
			}
			@keyframes terminal-gradient-flow {
				0% {
					transform: rotate(0deg);
				}
				100% {
					transform: rotate(360deg);
				}
			}

			.terminal-widget {
				position: fixed;
				bottom: 6rem;
				right: 2rem;
				width: 760px;
				height: 480px;
				max-width: calc(100vw - 4rem);
				max-height: calc(100vh - 9rem);
				z-index: 1000;
				display: flex;
				flex-direction: column;
				opacity: 0;
				transform: translateY(20px) scale(0.95);
				pointer-events: none;
				transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
			}
			.terminal-widget.open {
				opacity: 1;
				transform: translateY(0) scale(1);
				pointer-events: auto;
			}
			.terminal-widget.maximized {
				width: 100vw !important;
				height: 100vh !important;
				top: 0 !important;
				left: 0 !important;
				bottom: 0 !important;
				right: 0 !important;
				max-width: none !important;
				max-height: none !important;
				border-radius: 0 !important;
			}
			.terminal-widget.maximized .terminal-window {
				border-radius: 0 !important;
				box-shadow: none !important;
			}
			.terminal-widget.minimized {
				height: auto !important;
			}
			.terminal-widget.minimized .terminal-body {
				display: none !important;
			}
			.terminal-widget .terminal-window {
				height: 100%;
				display: flex;
				flex-direction: column;
				box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
			}
			.terminal-widget .terminal-body {
				flex: 1;
				display: block !important;
				overflow-y: auto;
				min-height: 0;
				padding: 0.75rem 1rem;
			}
			.terminal-widget .terminal-output {
				max-height: none;
				overflow-y: visible;
				margin-bottom: 0.5rem;
			}
			.terminal-widget .dot.red {
				cursor: pointer;
				position: relative;
			}
			.terminal-widget .dot.red:hover::after {
				content: '×';
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -52%);
				font-size: 8px;
				color: rgba(0, 0, 0, 0.6);
				font-weight: bold;
			}
			.terminal-widget .dot.yellow {
				cursor: pointer;
				position: relative;
			}
			.terminal-widget .dot.yellow:hover::after {
				content: '–';
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -55%);
				font-size: 8px;
				color: rgba(0, 0, 0, 0.6);
				font-weight: bold;
			}
			.terminal-widget .dot.green {
				cursor: pointer;
				position: relative;
			}
			.terminal-widget .dot.green:hover::after {
				content: '+';
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
				font-size: 8px;
				color: rgba(0, 0, 0, 0.6);
				font-weight: bold;
			}

			@media (max-width: 640px) {
				.terminal-widget {
					top: calc(1rem + env(safe-area-inset-top));
					bottom: 5.5rem;
					right: 1rem;
					width: calc(100vw - 2rem);
					height: auto;
					max-width: none;
					max-height: none;
				}
				.terminal-trigger-btn {
					bottom: 1.5rem;
					right: 1rem;
				}
				.home-page main {
					padding: 1.25rem;
				}
			}

			/* THEME & CRT VARIABLES AND CONFIG */
			.terminal-window {
				--term-bg: #1a1d29;
				--term-title-bg: #252836;
				--term-text: #b0bad1;
				--term-accent: var(--accent);
				--term-dim: rgba(210, 215, 235, 0.7);
				--term-code-bg: rgba(123, 158, 255, 0.2);
				--term-cursor: var(--accent);
				--term-shadow: var(--box-shadow), 0 0 0 1px rgba(123, 158, 255, 0.15);

				font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, monospace;
				font-size: 0.85rem;
				line-height: 1.5;
				background: var(--term-bg);
				color: var(--term-text);
				border-radius: 10px;
				overflow-x: auto;
				overflow-y: hidden;
				box-shadow: var(--term-shadow);
				max-width: 100%;
				min-width: 0;
				position: relative;
			}

			/* MATRIX THEME */
			.terminal-window[data-theme="matrix"] {
				--term-bg: #050d06;
				--term-title-bg: #081609;
				--term-text: #39ff14;
				--term-accent: #39ff14;
				--term-dim: #22990d;
				--term-code-bg: rgba(57, 255, 20, 0.15);
				--term-cursor: #39ff14;
				--term-shadow: 0 12px 40px rgba(0, 0, 0, 0.85), 0 0 12px rgba(57, 255, 20, 0.35);
			}

			/* DRACULA THEME */
			.terminal-window[data-theme="dracula"] {
				--term-bg: #282a36;
				--term-title-bg: #1e1f29;
				--term-text: #f8f8f2;
				--term-accent: #ff79c6;
				--term-dim: #bd93f9;
				--term-code-bg: rgba(189, 147, 249, 0.25);
				--term-cursor: #50fa7b;
				--term-shadow: 0 12px 40px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(189, 147, 249, 0.3);
			}

			/* CYBERPUNK THEME */
			.terminal-window[data-theme="cyberpunk"] {
				--term-bg: #0b0c10;
				--term-title-bg: #1f2833;
				--term-text: #66fcf1;
				--term-accent: #ff007f;
				--term-dim: #45a29e;
				--term-code-bg: rgba(255, 0, 127, 0.2);
				--term-cursor: #ff007f;
				--term-shadow: 0 12px 40px rgba(0, 0, 0, 0.85), 0 0 12px rgba(255, 0, 127, 0.4);
			}

			/* LIGHT THEME */
			.terminal-window[data-theme="light"] {
				--term-bg: #f9fbfd;
				--term-title-bg: #eceff4;
				--term-text: #2e3440;
				--term-accent: #5e81ac;
				--term-dim: #4c566a;
				--term-code-bg: rgba(94, 129, 172, 0.15);
				--term-cursor: #2e3440;
				--term-shadow: 0 12px 30px rgba(0, 0, 0, 0.1), 0 0 0 1px rgba(0, 0, 0, 0.1);
			}

			/* CRT OVERLAY STYLING */
			.terminal-crt-overlay {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: radial-gradient(circle, rgba(255,255,255,0.03) 0%, rgba(0,0,0,0.15) 100%);
				pointer-events: none;
				z-index: 10;
				border-radius: inherit;
				display: none;
			}
			.terminal-crt-overlay::before {
				content: " ";
				display: block;
				position: absolute;
				top: 0; left: 0; bottom: 0; right: 0;
				background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
				z-index: 10;
				background-size: 100% 3px, 6px 100%;
				pointer-events: none;
				border-radius: inherit;
			}
			@keyframes crt-flicker {
				0% { opacity: 0.98; }
				50% { opacity: 1; }
				100% { opacity: 0.99; }
			}
			.crt-mode .terminal-crt-overlay {
				display: block;
				animation: crt-flicker 0.15s infinite;
			}

			.terminal-titlebar {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				padding: 0.5rem 0.75rem;
				background: var(--term-title-bg);
				border-bottom: 1px solid rgba(0, 0, 0, 0.3);
				cursor: move;
				user-select: none;
			}
			.terminal-dots {
				display: flex;
				gap: 6px;
			}
			.terminal-dots .dot {
				width: 10px;
				height: 10px;
				border-radius: 50%;
			}
			.terminal-dots .dot.red { background: #ff5f56; }
			.terminal-dots .dot.yellow { background: #ffbd2e; }
			.terminal-dots .dot.green { background: #27c93f; }
			.terminal-title {
				color: var(--term-dim);
				font-size: 0.75rem;
			}
			.terminal-body {
				display: block !important;
				padding: 0.75rem 1rem;
				min-height: 210px;
				overflow-y: auto;
				cursor: text;
				position: relative;
				background: var(--term-bg);
			}
			.terminal-output {
				margin-bottom: 0.5rem;
			}
			.terminal-output .term-line {
				margin-bottom: 0.25rem;
				word-break: break-word;
			}
			.terminal-output .term-line code {
				background: var(--term-code-bg);
				padding: 1px 4px;
				border-radius: 3px;
				color: var(--term-text);
			}
			.term-prompt {
				color: var(--term-accent);
				margin-right: 0.5rem;
			}
			/* Apply prompt color to dynamically appended lines */
			.terminal-output :global(.term-prompt) {
				color: var(--term-accent);
				margin-right: 0.5rem;
			}
			.term-prompt-short {
				display: none;
			}
			.terminal-input-line {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0;
			}
			.terminal-input-wrap {
				display: inline-flex;
				align-items: center;
				flex: 1;
				min-width: 0;
				position: relative;
			}
			.terminal-input-val {
				white-space: pre-wrap;
				word-break: break-all;
				font: inherit;
				color: var(--term-text);
				position: relative;
				z-index: 2;
			}
			.ghost-text {
				position: absolute;
				left: 0;
				top: 0;
				z-index: 1;
				color: #555555;
				font: inherit;
				white-space: pre-wrap;
				word-break: break-all;
				pointer-events: auto;
				width: 100%;
				user-select: none;
			}
			.terminal-input {
				position: absolute;
				left: 0;
				top: 0;
				width: 100%;
				height: 100%;
				color: transparent;
				background: transparent;
				caret-color: transparent;
				border: none;
				outline: none;
				font: inherit;
				padding: 0;
				margin: 0;
				z-index: 3;
			}
			.terminal-input::placeholder {
				color: rgba(210, 215, 235, 0.4);
			}
			.term-cursor {
				display: inline-block;
				width: 8px;
				height: 1.1em;
				background: var(--term-cursor);
				animation: blink 1s step-end infinite;
				vertical-align: text-bottom;
			}
			@keyframes blink {
				50% { opacity: 0; }
			}
			.terminal-output .term-response {
				color: var(--term-text);
				white-space: pre-wrap;
			}
			.terminal-output .term-response a {
				color: inherit;
				text-decoration: underline;
			}
			.terminal-output .term-response a:hover {
				color: var(--term-accent);
			}

			@media (max-width: 640px) {
				.home-page {
					overflow-x: hidden;
				}
				.home-page main {
					width: 100%;
					max-width: 100%;
					padding: 1rem;
					margin: 0.5rem 0;
					overflow-x: hidden;
				}
				.terminal-section {
					margin-top: 1.5rem;
				}
				.terminal-window {
					font-size: 0.75rem;
					border-radius: 8px;
					max-width: 100%;
				}
				.terminal-titlebar {
					padding: 0.4rem 0.6rem;
				}
				.terminal-title {
					max-width: 60%;
					overflow: hidden;
					text-overflow: ellipsis;
					white-space: nowrap;
				}
				.terminal-body {
					padding: 0.5rem 0.75rem;
					min-height: 180px;
					max-width: 100%;
					overflow-x: auto;
				}
				.terminal-output {
					max-height: 240px;
					margin-bottom: 0.4rem;
				}
				.terminal-input-line {
					min-width: 0;
				}
			}
			</style>

		<script is:inline>
			document.addEventListener('DOMContentLoaded', function () {

				const output = document.getElementById('term-output');
				const input = document.getElementById('term-input');
				const terminalWindow = document.getElementById('terminal-window');
				const ghostText = document.getElementById('ghost-text');
				if (!output || !input) return;

				// Web Audio API Retro Sound Synthesizer
				const TerminalSound = (function () {
					let audioCtx = null;
					let soundEnabled = true;
					let lastClickTime = 0;

					try {
						soundEnabled = localStorage.getItem('term_sound') !== 'false';
					} catch (e) {}

					function init() {
						if (!audioCtx) {
							const AudioContextClass = window.AudioContext || window.webkitAudioContext;
							if (AudioContextClass) {
								audioCtx = new AudioContextClass();
							}
						}
						if (audioCtx && audioCtx.state === 'suspended') {
							audioCtx.resume();
						}
					}

					function playClick() {
						if (!soundEnabled) return;
						init();
						if (!audioCtx) return;

						const now = audioCtx.currentTime;
						if (now - lastClickTime < 0.08) return;
						lastClickTime = now;

						const osc = audioCtx.createOscillator();
						const gain = audioCtx.createGain();

						osc.type = 'triangle';
						osc.frequency.setValueAtTime(600, now);
						osc.frequency.exponentialRampToValueAtTime(80, now + 0.015);

						gain.gain.setValueAtTime(0.007, now);
						gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.015);

						osc.connect(gain);
						gain.connect(audioCtx.destination);

						osc.start(now);
						osc.stop(now + 0.015);
					}

					function playError() {
						if (!soundEnabled) return;
						init();
						if (!audioCtx) return;

						const now = audioCtx.currentTime;
						const osc = audioCtx.createOscillator();
						const gain = audioCtx.createGain();

						osc.type = 'sawtooth';
						osc.frequency.setValueAtTime(110, now);
						osc.frequency.setValueAtTime(80, now + 0.08);

						gain.gain.setValueAtTime(0.04, now);
						gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.16);

						osc.connect(gain);
						gain.connect(audioCtx.destination);

						osc.start(now);
						osc.stop(now + 0.16);
					}

					function playStartup() {
						if (!soundEnabled) return;
						init();
						if (!audioCtx) return;

						const now = audioCtx.currentTime;
						const notes = [261.63, 329.63, 392.00, 523.25]; // C4, E4, G4, C5 (Retro rising arpeggio)
						
						notes.forEach(function (freq, index) {
							const osc = audioCtx.createOscillator();
							const gain = audioCtx.createGain();
							const time = now + index * 0.1;

							osc.type = 'sine';
							osc.frequency.setValueAtTime(freq, time);

							gain.gain.setValueAtTime(0, time);
							gain.gain.linearRampToValueAtTime(0.03, time + 0.02);
							gain.gain.exponentialRampToValueAtTime(0.0001, time + 0.22);

							osc.connect(gain);
							gain.connect(audioCtx.destination);

							osc.start(time);
							osc.stop(time + 0.25);
						});
					}

					return {
						init: init,
						playClick: playClick,
						playError: playError,
						playStartup: playStartup,
						setSoundEnabled: function (enabled) {
							soundEnabled = enabled;
							try {
								localStorage.setItem('term_sound', String(enabled));
							} catch (e) {}
						},
						isSoundEnabled: function () {
							return soundEnabled;
						}
					};
				})();

				const autocompleteCandidates = [
					'whoami',
					'ping skills',
