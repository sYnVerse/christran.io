---
---

<div id="search-modal" class="search-modal-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="search-input-label">
	<div class="search-modal-container" id="search-modal-container">
		<header class="search-modal-header">
			<svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="11" cy="11" r="8"></circle>
				<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
			</svg>
			<span id="search-input-label" class="sr-only">Search the website</span>
			<input
				type="text"
				id="search-input"
				placeholder="Search articles, projects, logs..."
				autocomplete="off"
				spellcheck="false"
			/>
			<button id="search-close-btn" class="search-close-btn" aria-label="Close search">
				<kbd class="kbd-hint">ESC</kbd>
				<span class="close-icon" aria-hidden="true">&times;</span>
			</button>
		</header>

		<div class="search-results-wrapper" id="search-results-wrapper">
			<div class="search-suggestions" id="search-suggestions">
				<p class="section-title">Suggested Searches</p>
				<ul class="suggestions-list">
					<li><a href="/portfolio/homelab" class="suggestion-item">Enterprise Home Lab</a></li>
					<li><a href="/resume" class="suggestion-item">Professional Resume</a></li>
					<li><a href="/blog" class="suggestion-item">Latest Blog Posts</a></li>
				</ul>
			</div>

			<div class="search-results" id="search-results" style="display: none;">
				<!-- Dynamic results injected here -->
			</div>

			<div class="search-empty-state" id="search-empty-state" style="display: none;">
				<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
					<line x1="8" y1="11" x2="14" y2="11"></line>
				</svg>
				<p>No results found for "<span id="search-query-display"></span>"</p>
				<span class="empty-hint">Try searching for other terms like "virtualization", "ansible", or "WGU".</span>
			</div>
		</div>

		<footer class="search-modal-footer">
			<div class="footer-shortcuts">
				<span><kbd class="kbd-key">↑↓</kbd> Navigate</span>
				<span><kbd class="kbd-key">Enter</kbd> Select</span>
				<span><kbd class="kbd-key">Esc</kbd> Close</span>
			</div>
			<div class="footer-branding">
				<span>Search powered by ChrisTran.io</span>
			</div>
		</footer>
	</div>
</div>

<script>
	let searchInstance: any = null;
	let loadingSearch = false;

	const loadSearch = async () => {
		if (searchInstance) return searchInstance;
		if (loadingSearch) {
			return new Promise((resolve) => {
				const check = setInterval(() => {
					if (searchInstance) {
						clearInterval(check);
						resolve(searchInstance);
					}
				}, 50);
			});
		}
		loadingSearch = true;
		try {
			const searchModule = await import('../scripts/search.ts');
			searchInstance = searchModule.initSearch();
			loadingSearch = false;
			return searchInstance;
		} catch (err) {
			console.error('Failed to dynamically load search script:', err);
			loadingSearch = false;
			return null;
		}
	};

	// 1. Listen for clicks on the search trigger
	document.addEventListener('click', async (e) => {
		const target = e.target as HTMLElement;
		const trigger = target.closest('.search-trigger');
		if (trigger) {
			e.preventDefault();
			const search = await loadSearch();
			if (search) {
				search.open(trigger as HTMLElement);
			}
		}
	});

	// 2. Setup prefetch on hovering search trigger
	document.addEventListener('mouseover', (e) => {
		const target = e.target as HTMLElement;
		if (target.closest('.search-trigger')) {
			loadSearch();
		}
	}, { passive: true });

	// 3. Setup keydown listener for keyboard shortcuts (Ctrl+K / Cmd+K)
	document.addEventListener('keydown', async (e) => {
		if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
			e.preventDefault();
			const search = await loadSearch();
			if (search) {
				const modal = document.getElementById('search-modal');
				const modalOpen = modal && modal.classList.contains('open');
				if (modalOpen) {
					search.close();
				} else {
					search.open();
				}
			}
		}
	});

	// 4. WebMCP Tool Registration (Eagerly registered so agents can see the tool)
	const modelContext = (document as any).modelContext || (typeof navigator !== 'undefined' && (navigator as any).modelContext);
	if (modelContext && typeof modelContext.registerTool === 'function') {
		modelContext.registerTool({
			name: 'search_website',
			description: 'Search the website index for blog posts and portfolio projects matching a query string.',
			inputSchema: {
				type: 'object',
				properties: {
					query: {
						type: 'string',
						description: 'The search term or query string to look for'
					}
				},
				required: ['query']
			},
			execute: async ({ query }: { query: string }) => {
				const search = await loadSearch();
				if (search) {
					return search.executeFromAgent(query);
				}
				throw new Error('Search module could not be initialized.');
			}
		});
	}
</script>

<style>
	.search-modal-overlay {
		position: fixed;
		inset: 0;
		z-index: 10000;
		background: rgba(11, 16, 33, 0.75);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding: 12vh 2rem 2rem;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.2s;
	}

	.search-modal-overlay.open {
		opacity: 1;
		visibility: visible;
	}

	.search-modal-container {
		width: 100%;
		max-width: 640px;
		background: rgba(26, 29, 41, 0.95);
		border: 1px solid rgba(123, 158, 255, 0.15);
		border-radius: 12px;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.05);
		display: flex;
		flex-direction: column;
		max-height: 70vh;
		transform: scale(0.97) translateY(-8px);
		transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		overflow: hidden;
	}

	.search-modal-overlay.open .search-modal-container {
		transform: scale(1) translateY(0);
	}

	.search-modal-header {
		display: flex;
		align-items: center;
		padding: 1rem 1.25rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		gap: 0.75rem;
	}

	.search-icon {
		color: var(--accent);
		opacity: 0.8;
		flex-shrink: 0;
	}

	#search-input {
		flex: 1;
		background: transparent;
		border: none;
		outline: none;
		color: rgb(var(--gray-dark));
		font-family: inherit;
		font-size: 1rem;
		padding: 0.25rem 0;
	}

	#search-input::placeholder {
		color: rgba(176, 186, 209, 0.4);
	}

	.search-close-btn {
		background: transparent;
		border: none;
		color: rgb(var(--gray));
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.25rem 0.5rem;
		border-radius: 6px;
		transition: all 0.2s ease;
	}

	.search-close-btn:hover {
		color: #ffffff;
		background: rgba(255, 255, 255, 0.05);
	}

	.kbd-hint {
		font-family: inherit;
		font-size: 0.7rem;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 4px;
		padding: 2px 5px;
		color: rgb(var(--gray));
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
	}

	.close-icon {
		font-size: 1.25rem;
		line-height: 1;
	}

	/* Results container scroll wrap */
	.search-results-wrapper {
		flex: 1;
		overflow-y: auto;
		padding: 1.25rem;
		min-height: 120px;
	}

	.section-title {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent);
		margin: 0 0 0.75rem 0;
		font-weight: 700;
		opacity: 0.85;
	}

	.suggestions-list, .results-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.suggestion-item {
		display: block;
		padding: 0.6rem 0.8rem;
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.04);
		border-radius: 8px;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-size: 0.9rem;
		transition: all 0.2s ease;
	}

	.suggestion-item:hover {
		background: rgba(123, 158, 255, 0.08);
		border-color: rgba(123, 158, 255, 0.25);
		color: #ffffff;
		transform: translateX(3px);
	}

	/* Result cards */
	.result-card {
		display: flex;
		flex-direction: column;
		padding: 0.75rem 1rem;
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.04);
		border-radius: 8px;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		transition: all 0.2s ease;
		cursor: pointer;
	}

	.result-card:hover, .result-card.active {
		background: rgba(123, 158, 255, 0.08);
		border-color: rgba(123, 158, 255, 0.3);
		color: #ffffff;
		outline: none;
	}
	
	.result-card.active {
		box-shadow: 0 0 12px rgba(123, 158, 255, 0.1);
	}

	.result-card-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.25rem;
	}

	.result-title {
		font-weight: 600;
		font-size: 0.95rem;
	}

	.result-date {
		font-size: 0.75rem;
		color: rgb(var(--gray));
	}

	.result-badge {
		font-size: 0.7rem;
		background: rgba(123, 158, 255, 0.15);
		border: 1px solid rgba(123, 158, 255, 0.2);
		color: var(--accent);
		padding: 1px 6px;
		border-radius: 4px;
		font-weight: 500;
	}

	.result-desc {
		font-size: 0.85rem;
		color: rgb(var(--gray));
		margin: 0;
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.result-card:hover .result-desc, .result-card.active .result-desc {
		color: rgb(var(--gray-dark));
	}

	.result-tags {
		display: flex;
		gap: 0.4rem;
		margin-top: 0.5rem;
		flex-wrap: wrap;
	}

	.result-tag {
		font-size: 0.7rem;
		background: rgba(255, 255, 255, 0.05);
		color: rgb(var(--gray));
		padding: 1px 6px;
		border-radius: 3px;
	}

	/* Highlights matching parts */
	:global(.search-highlight) {
		background: rgba(123, 158, 255, 0.25);
		color: #ffffff;
		border-radius: 2px;
		padding: 0 1px;
		font-weight: inherit;
	}

	.results-section {
		margin-bottom: 1.5rem;
	}

	.results-section:last-child {
		margin-bottom: 0;
	}

	/* Empty state styling */
	.search-empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 3rem 1.5rem;
		text-align: center;
		color: rgb(var(--gray));
	}

	.search-empty-state svg {
		color: var(--accent);
		opacity: 0.5;
		margin-bottom: 1rem;
	}

	.search-empty-state p {
		margin: 0 0 0.5rem 0;
		font-size: 0.95rem;
		font-weight: 600;
		color: rgb(var(--gray-dark));
	}

	.empty-hint {
		font-size: 0.8rem;
		opacity: 0.75;
	}

	/* Modal footer and shortcuts */
	.search-modal-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.75rem 1.25rem;
		background: #141722;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		font-size: 0.7rem;
		color: rgb(var(--gray));
	}

	.footer-shortcuts {
		display: flex;
		gap: 1rem;
	}

	.kbd-key {
		font-family: inherit;
		font-size: 0.65rem;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 3px;
		padding: 1px 4px;
		color: rgb(var(--gray-dark));
		box-shadow: 0 1px 1px rgba(0, 0, 0, 0.2);
	}

	.footer-branding {
		opacity: 0.6;
	}

	@media (max-width: 640px) {
		.search-modal-overlay {
			padding: 0;
		}

		.search-modal-container {
			max-height: 100vh;
			height: 100%;
			border-radius: 0;
			border: none;
		}

		.footer-shortcuts {
			display: none;
		}
	}
</style>
